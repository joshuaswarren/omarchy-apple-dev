class XibError(Exception):
    pass


class Obj:
    def __init__(self, builder, cls):
        self.idx = len(builder.objects)
        builder.objects.append(self)
        self.cls = cls
        self.values = []  # (key str, N.Value payload tuple: (type, payload))

    def add(self, key, vtype, payload):
        self.values.append((key, N.Value(0, vtype, payload)))  # key_idx patched later


class Builder:
    def __init__(self):
        self.objects = []
        self.strings = {}  # text -> Obj
        self.colors = {}   # (name, resource tuple) -> Obj
        self.fonts = {}    # font key -> Obj
        self.images = {}   # SF symbol resource name -> Obj
        self.state_nums = {}  # button state value -> pooled NSNumber
        self.kv_pairs = []  # UINibKeyValuePair objects (root UINibKeyValuePairsKey)

    def new(self, cls):
        return Obj(self, cls)

    @staticmethod
    def int16(v):
        return (N.INT16, v)

    @staticmethod
    def int_fit(v):
        """Minimal-width integer (golden event masks: 64 -> int8, 4096 -> int16)."""
        return (N.INT8 if -128 <= v < 128 else N.INT16, v)

    def nsvalue_rect(self, rect):
        o = self.new("NSValue")
        o.add("NS.special", *self.int8(3))
        o.add("NS.rectval", *self.ref(self.string(rect)))
        return o

    def kv_pair(self, obj, value_thunk, key_path):
        """Deferred: Apple creates the pair object, then its value, after the
        connections (golden Inspector/Settings nibs). value_thunk is a callable
        returning the value object, invoked at flush time."""
        self.kv_pairs.append((obj, value_thunk, key_path))
        return None

    def kv_pair_flush(self):
        # materialize in target creation order (gold 1m3/Settings key-value tail)
        self.kv_pairs.sort(key=lambda e: e[0].idx)
        pairs = []
        for obj, thunk, key_path in self.kv_pairs:
            if key_path is None:
                # UDA group thunk: returns a list of ready UINibKeyValuePair
                pairs.extend(thunk())
                continue
            kv = self.new("UINibKeyValuePair")
            kv.add("UIObject", *self.ref(obj))
            kv.add("UIValue", *self.ref(thunk()))
            kv.add("UIKeyPath", *self.ref(self.string(key_path)))
            pairs.append(kv)
        self.kv_pairs = []
        return pairs

    def nsvalue_size(self, size):
        o = self.new("NSValue")
        o.add("NS.special", *self.int8(2))
        o.add("NS.sizeval", *self.ref(self.string(size)))
        return o

    def string(self, text):
        obj = self.strings.get(text)
        if obj is None:
            obj = self.new("NSString")
            obj.add("NS.bytes", N.DATA, text.encode("utf-8"))
            self.strings[text] = obj
        return obj

    def image_placeholder(self, name):
        """UIImageNibPlaceholder for a catalog="system" (SF Symbols) image."""
        obj = self.images.get(name)
        if obj is None:
            obj = self.new("UIImageNibPlaceholder")
            obj.add("UIImageWidth", *self.float32(0.0))
            obj.add("UIImageHeight", *self.float32(0.0))
            s = self.string(name)
            obj.add("UIResourceName", *self.ref(s))
            obj.add("UISystemSymbolResourceName", *self.ref(s))
            obj.add("UISymbolImageConfiguration", N.NIL, None)
            obj.add("UIResourceCatalogName", N.NIL, None)
            self.images[name] = obj
        return obj

    def ref(self, obj):
        return (N.OBJREF, obj.idx)

    @staticmethod
    def boolean(v):
        return (N.TRUE if v else N.FALSE, None)

    @staticmethod
    def int8(v):
        return (N.INT8, v)

    @staticmethod
    def int64(v):
        return (N.INT64, v)

    @staticmethod
    def float32(v):
        return (N.FLOAT, struct.unpack("<f", struct.pack("<f", v))[0])

    @staticmethod
    def float64(v):
        return (N.DOUBLE, v)

    @staticmethod
    def geom(*nums):
        return (N.DATA, b"\x07" + struct.pack(f"<{len(nums)}d", *nums))


def _attr(el, name, where):
    v = el.get(name)
    if v is None:
        raise XibError(f"<{el.tag}> is missing attribute {name!r} ({where})")
    return v


def _localizable(b, text, key):
    """User-visible string: NSLocalizableString in storyboards (keyed for .strings
    extraction), a pooled plain string in xibs and for the empty string."""
    if text == "" or not LOCALIZE or key is None:
        return b.string(text)
    o = b.new("NSLocalizableString")
    o.add("NS.bytes", N.DATA, text.encode("utf-8"))
    o.add("NSKey", *b.ref(b.string(key)))
    o.add("NSDev", *b.ref(b.string(text)))
    return o


def _sub(el, key, where):
    child = el.find(f"*[@key='{key}']")
    if child is None:
        raise XibError(f"<{el.tag}> is missing <key='{key}'> subelement ({where})")
    return child


def _bounds_center(el):
    x, y, w, h = _frame(el)
    return (0.0, 0.0, w, h), (x + w / 2, y + h / 2)


def _autoresizing_mask(el, where, default=36):
    m = el.find("autoresizingMask[@key='autoresizingMask']")
    if m is None:
        return default
    mask = 0
    for flag, bit in RESIZE_FLAGS.items():
        if m.get(flag) == "YES":
            mask |= bit
    unknown = set(m.attrib) - {"key", *RESIZE_FLAGS}
    if unknown:
        raise XibError(f"<{el.tag}> autoresizingMask has unsupported {sorted(unknown)} ({where})")
    return mask


# Apple's ibtool gives an element saved without a design-time frame a
# 1000 x 1000 one at the origin (Runner LaunchScreen golden: the scene view and
# its image view, both sized by constraints at run time).
FRAMELESS_TAGS = {"view", "imageView"}
FRAMELESS_RECT = (0.0, 0.0, 1000.0, 1000.0)
PRE_17_FRAMELESS_SCENE_SIZE = (393, 852)


def _frame(el):
    if el.tag in FRAMELESS_TAGS and el.find("rect[@key='frame']") is None:
        return FRAMELESS_RECT
    rect = _sub(el, "frame", el.tag)
    try:
        return (float(rect.get("x", "0.0")), float(rect.get("y", "0.0")),
                float(rect.get("width")), float(rect.get("height")))
    except (TypeError, ValueError):
        raise XibError(f"<{el.tag}> has an unparsable frame rect")


def build_color(b, name, where, resources=None):
    key = (name, resources.get(name) if resources else None)
    if key in b.colors:
        return b.colors[key]
    obj = _build_color_new(b, name, where, resources)
    b.colors[key] = obj
    return obj


def _color_components(b, c, spec):
    """The component keys of a ('white', w, a) or ('rgba', r, g, b, a) spec: a
    -Double only when the float32 loses precision, NSRGB from %.3g with three
    components when opaque (probe ins-button)."""
    if spec[0] == "white":
        _, w, al = spec
        c.add("UIColorComponentCount", *b.int8(2))
        c.add("UIWhite", *b.float32(w))
        c.add("UIAlpha", *b.float32(al))
        c.add("NSWhite", N.DATA,
              (f"{w:g}" if al == 1.0 else f"{w:g} {al:g}").encode("ascii"))
        c.add("NSColorSpace", *b.int8(4))
        return c
    _, r, g, bl, al = spec
    c.add("UIColorComponentCount", *b.int8(4))
    for k, v in (("UIRed", r), ("UIGreen", g), ("UIBlue", bl), ("UIAlpha", al)):
        c.add(k, *b.float32(v))
        if struct.unpack("<f", struct.pack("<f", v))[0] != v:
            c.add(k + "-Double", *b.float64(v))
    comps = (r, g, bl) if al == 1.0 else (r, g, bl, al)
    c.add("NSRGB", N.DATA, " ".join(f"{v:.3g}" for v in comps).encode("ascii"))
    c.add("NSColorSpace", *b.int8(2))
    return c


def _build_color_new(b, name, where, resources):
    spec = SYSTEM_COLORS.get(name) or (resources or {}).get(name)
    if spec is None:
        raise XibError(f"unsupported color {name!r} ({where})")
    if spec[0] == "rgba":
        # Apple rounds system color component doubles to 10 significant digits.
        spec = ("rgba",) + tuple(float(f"{v:.10g}") for v in spec[1:])
    c = b.new("UIColor")
    c.add("UISystemColorName", *b.ref(b.string(name)))
    return _color_components(b, c, spec)


def build_clear_color(b, where):
    """An uncached UIColor clearColor (tint white=0/alpha=0, button background)."""
    return _build_color_new(b, "clearColor", where, None)


def build_named_color(b, name, named, where):
    """A <color name=.../> from a <namedColor> document resource: dynamic catalog
    color storing the raw XML doubles (probe ins-button ins-image)."""
    key = ("named:" + name, named.get(name))
    if key in b.colors:
        return b.colors[key]
    if not named.get(name):
        raise XibError(f"unsupported color {name!r}: no namedColor resource ({where})")
    c = b.new("UIColor")
    c.add("UIDynamicCatalogName", *b.ref(b.string(name)))
    c.add("UIDynamicCatalogUseNibBundle", *b.boolean(False))
    b.colors[key] = _color_components(b, c, named[name])
    return c


def build_color_el(b, el, where, resources, named):
    """One inline <color key=.../> element in any supported form."""
    if el is None:
        raise XibError(f"missing <color> ({where})")
    if el.get("systemColor") is not None:
        return build_color(b, el.get("systemColor"), where, resources)
    if el.get("name") is not None:
        return build_named_color(b, el.get("name"), named, where)
    if (el.get("white") == "0.0" and el.get("alpha") == "0.0"
            and el.get("customColorSpace") == "genericGamma22GrayColorSpace"):
        return build_color(b, "clearColor", where)
    if el.get("red") is not None:
        return build_rgb_color(b, el, where)
    if el.get("white") is not None and el.get("customColorSpace") == "calibratedWhite":
        return build_calibrated_white_color(b, el, where)
    raise XibError(f"unsupported color element {el.attrib} ({where})")


def build_calibrated_white_color(b, color, where):
    """An inline <color white= alpha= customColorSpace="calibratedWhite">, the
    form Xcode 7-era documents (Flutter's template storyboards) carry. Apple
    stores it as an RGB color with the white repeated, not as a white color
    (Runner Main golden: white=1 alpha=1 -> NSRGB "1 1 1", NSColorSpace 2)."""
    if color.get("colorSpace") != "custom":
        raise XibError(f"<color> {dict(color.attrib)} is not a custom-space color ({where})")
    # The white goes through float32 and both components are rounded to ten
    # significant digits; the -Double keys carry the result (probes: white 1/3
    # -> 0.3333333433, white 2/3 -> 0.6666666865, while alpha 0.1 stays 0.1).
    f32 = struct.unpack("<f", struct.pack("<f", float(_attr(color, "white", where))))[0]
    w = float(f"{f32:.10g}")
    al = float(f"{float(_attr(color, 'alpha', where)):.10g}")
    return _color_components(b, b.new("UIColor"), ("rgba", w, w, w, al))


def build_rgb_color(b, color, where):
    """An inline sRGB <color red= green= blue= alpha=>. Only components exact in float32 are
    supported: Apple's golden (MainInterface.storyboard, all zero) stores no -Double values for them."""
    if color.get("colorSpace") != "custom" or color.get("customColorSpace") != "sRGB":
        raise XibError(f"<color> {dict(color.attrib)} is not an sRGB color ({where})")
    comps = [float(_attr(color, k, where)) for k in ("red", "green", "blue", "alpha")]
    if any(struct.unpack("<f", struct.pack("<f", v))[0] != v for v in comps):
        raise XibError(f"<color> {comps} needs -Double components, not derived yet ({where})")
    c = b.new("UIColor")
    c.add("UIColorComponentCount", *b.int8(4))
    for k, v in zip(("UIRed", "UIGreen", "UIBlue", "UIAlpha"), comps):
        c.add(k, *b.float32(v))
    # NSRGB drops the alpha when the color is opaque, as for system and named
    # colors (Runner LaunchScreen golden: 1 1 1 1 -> "1 1 1").
    if comps[3] == 1.0:
        comps = comps[:3]
    c.add("NSRGB", N.DATA, " ".join(f"{v:.3g}" for v in comps).encode("ascii"))
    c.add("NSColorSpace", *b.int8(2))
    return c


def build_font(b, fd, where):
    if fd.get("style") is not None:
        key = ("style", fd.get("style"))
        if key in b.fonts:
            return b.fonts[key]
        obj = _build_font_new(b, fd, where)
        b.fonts[key] = obj
        return obj
    key = (fd.get("type"), fd.get("pointSize"))
    if key in b.fonts:
        return b.fonts[key]
    obj = _build_font_new(b, fd, where)
    b.fonts[key] = obj
    return obj


def _build_font_new(b, fd, where):
    if fd.get("style") is not None:
        style = fd.get("style")
        if style not in FONT_STYLES:
            raise XibError(f"unsupported fontDescription style {style!r} ({where})")
        name, traits, size = FONT_STYLES[style]
        f = b.new("UIFont")
        f.add("UIFontName", *b.ref(b.string(name)))
        f.add("UIIBTextStyle", *b.ref(b.string(style)))
        f.add("UIFontPointSize", *b.float64(0.0))
        f.add("UIFontTextStyleForScaling", N.NIL, None)
        f.add("UIFontPointSizeForScaling", *b.float64(0.0))
        f.add("UIFontMaximumPointSizeAfterScaling", *b.float64(0.0))
        f.add("UIFontTraits", *b.int8(traits))
        f.add("UISystemFont", *b.boolean(False))
        f.add("NSName", *b.ref(b.string(name)))  # pool hit
        f.add("NSSize", *b.float64(size))
        return f
    if fd.get("type") not in ("system", "boldSystem") or fd.get("pointSize") is None:
        raise XibError(f"unsupported fontDescription {fd.attrib} ({where})")
    size = float(fd.get("pointSize"))
    # boldSystem (golden HelloWorld LaunchScreen, React Native's template):
    # .SFUI-Bold, the emphasized usage overridden by the bold usage, in a
    # mutable dictionary, with the bold trait.
    bold = fd.get("type") == "boldSystem"
    name = ".SFUI-Bold" if bold else ".SFUI-Regular"
    f = b.new("UIFont")
    f.add("UIFontName", *b.ref(b.string(name)))
    desc = b.new("UIFontDescriptor")  # shell first: golden creates it before the dict
    if bold:
        entries = [("NSCTFontUIUsageAttribute", "CTFontEmphasizedUsage"),
                   ("NSCTFontUIUsageOverrideAttribute", "CTFontBoldUsage"),
                   ("NSFontSizeAttribute", None)]
    else:
        entries = [("NSCTFontUIUsageAttribute", "CTFontRegularUsage"),
                   ("NSFontSizeAttribute", None)]
    attrs = b.new("NSMutableDictionary" if bold else "NSDictionary")
    attrs.add("NSInlinedValue", *b.boolean(False))
    for k, v in entries:
        attrs.add("UINibEncoderEmptyKey", *b.ref(b.string(k)))
        if v is None:
            num = b.new("NSNumber")
            num.add("NS.dblval", *b.float64(size))
            attrs.add("UINibEncoderEmptyKey", *b.ref(num))
        else:
            attrs.add("UINibEncoderEmptyKey", *b.ref(b.string(v)))
    desc.add("UIFontDescriptorAttributes", *b.ref(attrs))
    desc.add("UIFontDescriptorOptions", *b.int64(2147517444))
    f.add("UIFontDescriptor", *b.ref(desc))
    f.add("UIFontPointSize", *b.float64(size))
    f.add("UIFontTextStyleForScaling", N.NIL, None)
    f.add("UIFontPointSizeForScaling", *b.float64(0.0))
    f.add("UIFontMaximumPointSizeAfterScaling", *b.float64(0.0))
    f.add("UIFontTraits", *b.int8(2 if bold else 0))
    f.add("UISystemFont", *b.boolean(False))
    f.add("NSName", *b.ref(b.string(name)))  # pool hit
    f.add("NSSize", *b.float64(size))
    return f


