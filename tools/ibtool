def compile_storyboard(path, compilation_dir):
    """Xcode's CompileStoryboard: write <dir>/<name>.storyboardc/ with the
    per-VC nibs and Info.plist (the app-bundle layout). User strings are
    NSLocalizableString iff the output lands in an .lproj and the storyboard is
    no launch screen (oracle: src/Settings.storyboard compiled into Base.lproj
    is localized; the shipped app's bundle-root Settings/Inspector are not)."""
    tree = ET.parse(path)
    doc = tree.getroot()
    if doc.get("targetRuntime") != "iOS.CocoaTouch":
        raise XibError(f"{path}: targetRuntime {doc.get('targetRuntime')!r} is not iOS.CocoaTouch")
    name = os.path.splitext(os.path.basename(path))[0]
    global LOCALIZE
    old_localize = LOCALIZE
    LOCALIZE = doc.get("launchScreen") != "YES" and any(
        part.endswith(".lproj") for part in os.path.abspath(compilation_dir).split(os.sep))
    try:
        return _compile_storyboard_inner(path, compilation_dir, doc, name)
    finally:
        LOCALIZE = old_localize



def _compile_storyboard_inner(path, compilation_dir, doc, name):
    resources, named = _parse_color_resources(doc, path)
    dev_el = doc.find("device")
    device = dev_el.get("id") if dev_el is not None else None
    if dev_el is not None and (dev_el.get("orientation") != "portrait"
                               or device not in DEVICE_SIZES):
        raise XibError(f"{path}: device {dev_el.attrib} unsupported")
    scenes = doc.findall("scenes/scene")
    if not scenes:
        raise XibError(f"{path}: no scenes")
    identifiers = {}
    id_to_name = {}
    entry_id = doc.get("initialViewController")
    sbc = os.path.join(compilation_dir, f"{name}.storyboardc")
    os.makedirs(sbc, exist_ok=True)
    where = os.path.basename(path)
    # Navigation and split view controllers encode their child controllers
    # inside their own nib; only a child's view gets a nib of its own.
    embedded = {}
    splits = {}
    for scene in scenes:
        nav = scene.find("objects/navigationController")
        if nav is not None:
            segues = nav.findall("connections/segue")
            if len(segues) != 1 or segues[0].get("kind") != "relationship" \
                    or segues[0].get("relationship") != "rootViewController":
                raise XibError(f"{where}: navigationController {nav.get('id')} needs exactly one rootViewController")
            embedded[segues[0].get("destination")] = nav.get("id")
        split_el = scene.find("objects/splitViewController")
        if split_el is not None:
            kids = _split_relationship_children(split_el, where)
            splits[split_el.get("id")] = kids
            embedded.update(dict.fromkeys(kids, split_el.get("id")))
    vcs = {}
    for tag in ("viewController", "tableViewController", "collectionViewController"):
        for vc in doc.iterfind(f"scenes/scene/objects/{tag}"):
            vcs[vc.get("id")] = vc
    global NAV_BAR_CENTER_Y
    NAV_BAR_CENTER_Y = None
    for scene in scenes:
        nav = scene.find("objects/navigationController")
        if nav is not None:
            bar_rect = nav.find("navigationBar[@key='navigationBar']/rect[@key='frame']")
            if bar_rect is not None and bar_rect.get("y") is not None:
                NAV_BAR_CENTER_Y = float(bar_rect.get("y")) + 27.0
            break
    out_dir = sbc
    for scene in scenes:
        objs = scene.find("objects")
        nav = objs.find("navigationController") if objs is not None else None
        if nav is not None:
            root = vcs.get(next((k for k, v in embedded.items() if v == nav.get("id")), None))
            if root is None:
                raise XibError(f"{where}: navigationController {nav.get('id')} root not found")
            root_view = root.find("*[@key='view']")
            nav_builder = _scene_nav_nib_ident if nav.get("storyboardIdentifier") else _scene_nav_nib
            arch, vc_name = nav_builder(nav, root, f"{root.get('id')}-view-{root_view.get('id')}", where)
            with open(os.path.join(out_dir, vc_name + ".nib"), "wb") as f:
                f.write(arch)
            identifiers[vc_name] = vc_name
            id_to_name[nav.get("id")] = vc_name
            continue
        split_el = objs.find("splitViewController") if objs is not None else None
        if split_el is not None:
            kids = [vcs[k] for k in splits[split_el.get("id")]]
            arch, vc_name = _scene_split_nib(split_el, kids, where, resources, named)
            with open(os.path.join(out_dir, vc_name + ".nib"), "wb") as f:
                f.write(arch)
            identifiers[vc_name] = vc_name
            id_to_name[split_el.get("id")] = vc_name
            continue
        vc_el = None
        for tag in ("viewController", "tableViewController", "collectionViewController"):
            vc_el = objs.find(tag) if objs is not None else None
            if vc_el is not None:
                break
        if vc_el is None:
            raise XibError(f"{where}: scene has no viewController (unsupported scene kind)")
        view_el = vc_el.find("*[@key='view']")
        if view_el is None or not view_el.get("id"):
            raise XibError(f"{where}: viewController has no keyed view")
        vc_id = vc_el.get("id")
        if not vc_id:
            raise XibError(f"{where}: viewController has no id")
        view_nib = f"{vc_id}-view-{view_el.get('id')}"
        if view_el.tag == "tableView":
            table_device = device if vc_el.find("simulatedNavigationBarMetrics") is not None else None
            varch = _scene_table_view_nib(vc_el, view_el, where, resources, named, table_device)
        elif view_el.tag in ("view", "collectionView"):
            varch = _scene_view_nib(vc_el, view_el, where, resources, named, DEVICE_SIZES.get(device))
        else:
            raise XibError(f"{where}: unsupported view kind <{view_el.tag}>")
        with open(os.path.join(out_dir, view_nib + ".nib"), "wb") as f:
            f.write(varch)
        if vc_id in embedded and not vc_el.get("storyboardIdentifier"):
            continue
        arch, vc_name = _scene_vc_nib(vc_el, where, resources, named)
        with open(os.path.join(out_dir, vc_name + ".nib"), "wb") as f:
            f.write(arch)
        identifiers[vc_name] = vc_name
        id_to_name[vc_id] = vc_name
    entry = id_to_name.get(entry_id) if entry_id else None
    plist = {"UIViewControllerIdentifiersToNibNames": {
        key: identifiers[key] for key in keyorder.key_order(list(identifiers))}}
    if entry_id:
        plist["UIStoryboardDesignatedEntryPointIdentifier"] = entry
    plist["UIStoryboardVersion"] = 1
    # The entry-point value aliases its identifier key object iff the entry
    # controller has an explicit storyboardIdentifier (Xcode 27 oracle,
    # LaunchScreenPhone: generated name -> distinct refs, explicit -> aliased).
    entry_el = doc.find(f"scenes/scene/objects/*[@id='{entry_id}']") if entry_id else None
    alias_entry_key = entry_el is not None and entry_el.get("storyboardIdentifier") is not None
    with open(os.path.join(out_dir, "Info.plist"), "wb") as f:
        f.write(_bplist_bytes(plist, alias_entry_key))
    return sbc





def link_storyboards(out_dir, sources):
    """Xcode's LinkStoryboards: copy each .storyboardc into out_dir keeping
    its .lproj parent (verified: the golden trees carry nothing else)."""
    import shutil
    made = []
    for src in sources:
        parent = os.path.basename(os.path.dirname(os.path.abspath(src)))
        lproj = parent if parent.endswith(".lproj") else ""
        dest_dir = os.path.join(out_dir, lproj) if lproj else out_dir
        dest = os.path.join(dest_dir, os.path.basename(src))
        os.makedirs(dest_dir, exist_ok=True)
        shutil.copytree(src, dest, dirs_exist_ok=True)
        made.append(dest)
    return made


def _tree_bytes(root):
    out = {}
    for dirpath, _, files in os.walk(root):
        for f in files:
            p = os.path.join(dirpath, f)
            out[os.path.relpath(p, root)] = open(p, "rb").read()
    return out


