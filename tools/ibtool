        for ac in conns_el.findall("action"):
            events.append((ac.get("selector"), ac.get("destination"), ac.get("eventType"), o))
    pairs = _uda_pairs(b, el, o, resources, named) + kpairs
    return o, decode_order, outlets, events, pairs, cv, kids


def _parse_color_spec(sc, path):
    """One <systemColor|namedColor> resource -> ('rgba', r, g, b, a) or
    ('white', w, a). White-based resources (Main.storyboard:
    secondarySystemGroupedBackgroundColor) encode as two-component colors."""
    col = sc.find("color")
    if col is None:
        raise XibError(f"{path}: resource {sc.get('name')!r} has no color")
    try:
        return ("rgba", float(col.get("red")), float(col.get("green")),
                float(col.get("blue")), float(col.get("alpha")))
    except (TypeError, ValueError):
        pass
    try:
        return ("white", float(col.get("white")), float(col.get("alpha")))
    except (TypeError, ValueError):
        raise XibError(f"{path}: unparsable resource {sc.get('name')!r}")


def _parse_color_resources(doc, path):
    """Document <resources>: systemColor and namedColor component tables."""
    resources, named = {}, {}
    res_el = doc.find("resources")
    if res_el is not None:
        for sc in res_el.findall("systemColor"):
            resources[sc.get("name")] = _parse_color_spec(sc, path)
        for nc in res_el.findall("namedColor"):
            named[nc.get("name")] = _parse_color_spec(nc, path)
    return resources, named


def compile_xib(path):
    """Compile one xib to NIBArchive bytes. Mac files dispatch to ibmac."""
    doc = ET.parse(path).getroot()
    if doc.get("targetRuntime") == "MacOSX.Cocoa":
        import ibmac
        ibmac.set_target_module(TARGET_MODULE)
        return ibmac.compile_xib(path)
    if doc.get("targetRuntime") != "iOS.CocoaTouch":
        raise XibError(f"{path}: targetRuntime {doc.get('targetRuntime')!r} is not iOS.CocoaTouch")
    objects = doc.find("objects")
    if objects is None:
        raise XibError(f"{path}: no <objects> element")
    resources, named = _parse_color_resources(doc, path)

    where = os.path.basename(path)
    tops = []
    b = Builder()
    root = b.new("NSObject")
    top_array = b.new("NSArray")
    main_obj = decode_order = outlets = None
    events = []
    pairs = []
    proxies = {}
    for i, el in enumerate(objects):
        w = f"{where} object #{i}"
        if el.tag == "placeholder":
            _check_shape(el, w)
            ident = _attr(el, "placeholderIdentifier", w)
            if ident not in ("IBFilesOwner", "IBFirstResponder"):
                raise XibError(f"unsupported placeholder {ident!r} ({w})")
            p = b.new("UIProxyObject")
            p.add("UIProxiedObjectIdentifier", *b.ref(b.string(ident)))
            tops.append(p)
            proxies[("-1" if ident == "IBFilesOwner" else "-2")] = p
        elif main_obj is not None:
            raise XibError(f"{path}: multiple top-level objects are not supported")
        elif el.tag == "view":
            main_obj, decode_order, events, pairs = build_view(b, el, w, resources, named)
        elif el.tag == "label":
            main_obj = build_label(b, el, w)[0]
            decode_order = [main_obj]
        elif el.tag == "tableViewCell":
            main_obj, decode_order, outlets, events, pairs, _cv, _kids = build_cell(b, el, w, resources, named)
        else:
            raise XibError(f"unsupported element <{el.tag}> ({w})")
    if main_obj is None:
        raise XibError(f"{path}: no top-level object")
    objects_array = b.new("NSArray")

    def resolve(dst):
        if dst in proxies:
            return proxies[dst]
        raise XibError(f"{where}: unparsable connection destination {dst!r}")

    conn_array = None
    if (outlets or events):
        conn_array = b.new("NSArray")
        conn_array.add("NSInlinedValue", *b.boolean(False))
        for prop, target in sorted(outlets or [], key=lambda t: t[0]):
            c = b.new("UIRuntimeOutletConnection")
            c.add("UILabel", *b.ref(b.string(prop)))
            c.add("UISource", *b.ref(main_obj))
            c.add("UIDestination", *b.ref(target))
            conn_array.add("UINibEncoderEmptyKey", *b.ref(c))
        for sel, dst_id, ev, src in sorted(events, key=lambda t: t[0]):
            c = b.new("UIRuntimeEventConnection")
            c.add("UILabel", *b.ref(b.string(sel)))
            c.add("UISource", *b.ref(src))
            c.add("UIDestination", *b.ref(resolve(dst_id)))
            if ev is not None:
                if ev not in EVENT_MASKS:
                    raise XibError(f"{where}: unsupported eventType {ev!r}")
                c.add("UIEventMask", *b.int_fit(EVENT_MASKS[ev]))
            conn_array.add("UINibEncoderEmptyKey", *b.ref(c))
        empty_arr = b.new("NSArray")  # golden: shared empty right after connections
        empty_arr.add("NSInlinedValue", *b.boolean(False))
    else:
        # no connections: all five root lists share one empty array
        empty_arr = b.new("NSArray")
        empty_arr.add("NSInlinedValue", *b.boolean(False))
    conn = conn_array if conn_array is not None else empty_arr
    pairs_array = None
    if pairs:
        pairs_array = b.new("NSArray")
        pairs_array.add("NSInlinedValue", *b.boolean(False))
        for el, tgt in pairs:
            for p in _uda_build(b, el, tgt, resources, named):
                pairs_array.add("UINibEncoderEmptyKey", *b.ref(p))

    def fill_array(arr, items):
        arr.add("NSInlinedValue", *b.boolean(False))
        for item in items:
            arr.add("UINibEncoderEmptyKey", *b.ref(item))

    fill_array(top_array, tops + [main_obj])
    # UINibObjectsKey lists decode-order targets, not creation order (golden);
    # decode_order starts with the main object itself.
    fill_array(objects_array, tops + decode_order)
    root.add("UINibTopLevelObjectsKey", *b.ref(top_array))
    root.add("UINibObjectsKey", *b.ref(objects_array))
    root.add("UINibConnectionsKey", *b.ref(conn))
    root.add("UINibVisibleWindowsKey", *b.ref(empty_arr))
    root.add("UINibAccessibilityConfigurationsKey", *b.ref(empty_arr))
    root.add("UINibTraitStorageListsKey", *b.ref(empty_arr))
    root.add("UINibKeyValuePairsKey", *b.ref(pairs_array if pairs_array else empty_arr))
    root.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root)


def finalize(b, root):
    """Serialize a built object graph: key table (__NSSetM simulation over the
    first-intern order), class table, encode."""
    # Flatten values in object order; classes in first-use order.
    values = []
    classes = []
    class_idx = {}
    creation_keys = []
    creation_idx = {}
    SUPERCLASS = {"UIColor": "NSColor", "UIFont": "NSFont",
                  "UITableViewCellContentView": "UIView",
                  "_UILayoutGuide": "UIView",
                  "_UILayoutSupportConstraint": "NSLayoutConstraint"}
    for o in b.objects:
        o.value_start = len(values)
        for key, v in o.values:
            if key not in creation_idx:
                creation_idx[key] = len(creation_keys)
                creation_keys.append(key)
            v.key_idx = creation_idx[key]
            values.append(v)
        o.value_count = len(values) - o.value_start
        if o.cls not in class_idx:
            class_idx[o.cls] = len(classes)
            classes.append([o.cls, ()])
    for s in sorted({SUPERCLASS[c] for c in class_idx if c in SUPERCLASS}):
        if s in class_idx:
            continue
        class_idx[s] = len(classes)
        classes.append([s, ()])
    for c in classes:
        if c[0] in SUPERCLASS:
            c[1] = (class_idx[SUPERCLASS[c[0]]],)

    # Key table: run the __NSSetM simulation over the first-intern order
    # (inline DFS), derived from a probe archive of this exact graph.
    creation_keys = []
    seen = set()
    for o in b.objects:
        for key, _ in o.values:
            if key not in seen:
                seen.add(key)
                creation_keys.append(key)
    arch = N.Archive()
    arch.version = 1
    arch.minor = 10
    arch.keys = [k.encode("ascii") for k in creation_keys]
    arch.classes = [(name.encode("ascii") + b"\x00", extras) for name, extras in classes]
    arch.objects = [N.Object(class_idx[o.cls], o.value_start, o.value_count)
                    for o in b.objects]
    arch.values = values
    key_idx = {k: i for i, k in enumerate(creation_keys)}
    for o in b.objects:
        for key, v in o.values:
            v.key_idx = key_idx[key]

    key_bytes = keyorder.key_order(keyorder.first_use_order(arch))
    remap = {k: i for i, k in enumerate(key_bytes)}
    assert len(remap) == len(creation_keys) and all(k in remap for k in creation_keys)
    for v in values:
        v.key_idx = remap[creation_keys[v.key_idx]]
    arch.keys = [k.encode("ascii") for k in key_bytes]
    return N.encode(arch)


SELF_TEST_NIBS = ("TinyView", "TinyLabel", "SettingsTableViewCell", "SettingsComboTableViewCell")


def _bplist_bytes(plist, alias_entry_key=False):
    """Serialize storyboardc Info.plist with pre-order object assignment."""
    objects = []  # encoded bytes, index == object number
    identifier_key_refs = {}

    def assign(v, identifier_map=False):
        i = len(objects)
        objects.append(None)
        if isinstance(v, dict):
            krefs = [assign(k) for k in v]
            if identifier_map:
                identifier_key_refs.update(zip(v.keys(), krefs))
            vrefs = []
            for key in v:
                value = v[key]
                if key == "UIViewControllerIdentifiersToNibNames":
                    vrefs.append(assign(value, identifier_map=True))
                elif (key == "UIStoryboardDesignatedEntryPointIdentifier"
                      and alias_entry_key and value in identifier_key_refs):
                    vrefs.append(identifier_key_refs[value])
                else:
                    vrefs.append(assign(value))
            if len(v) > 15:
                raise XibError(f"Info.plist dict too large: {len(v)}")
            objects[i] = bytes([0xD0 | len(v)] + krefs + vrefs)
        elif isinstance(v, str):
            data = v.encode("ascii")
            if len(data) <= 14:
                objects[i] = bytes([0x50 | len(data)]) + data
            elif len(data) < 256:
                objects[i] = bytes([0x5F, 0x10, len(data)]) + data
            else:
                raise XibError("Info.plist string too long")
        elif isinstance(v, int) and 0 <= v < 256:
            objects[i] = bytes([0x10, v])
        else:
            raise XibError(f"unsupported Info.plist value {v!r}")
        return i

    assign(plist)
    body = b"".join(objects)
    off_sz = 1 if 8 + len(body) + len(objects) <= 255 else 2
    pos = 8  # offsets are absolute file positions (magic included)
    table = b""
    for x in objects:
        table += pos.to_bytes(off_sz, "big")
        pos += len(x)
    out = b"bplist00" + body + table
    out += b"\x00" * 5 + b"\x00" + bytes([off_sz, 1])
    out += len(objects).to_bytes(8, "big") + (0).to_bytes(8, "big")
    out += (8 + len(body)).to_bytes(8, "big")
    return out


def _add_multiplier(b, o, el):
    """NSLayoutConstraint's NSMultiplier for multiplier="1/3" or "0.5", after
    NSFirstAttribute and NSRelation, before NSSecondItem, written only when it
    is not 1. The value is a float widened to a double (golden HelloWorld
    LaunchScreen: 1/3 -> 0.3333333432674408; Xcode 27.1 probe with a >=
    relation)."""
    m = el.get("multiplier")
    if m is None or el.get("secondItem") is None:
        return
    num, _, den = m.partition("/")
    value = float(num) / float(den) if den else float(num)
    value = struct.unpack("<f", struct.pack("<f", value))[0]
    if value != 1.0:
        o.add("NSMultiplier", *b.float64(value))


def build_constraint(b, el, owner, id_map, where):
    o = b.new("NSLayoutConstraint")
    first = el.get("firstItem")
    o.add("NSFirstItem", *b.ref(id_map[first] if first else owner))
    fa = el.get("firstAttribute")
    if fa is None:
        raise XibError(f"<constraint> missing firstAttribute ({where})")
    o.add("NSFirstAttributeV2", *b.int8(ATTRIBUTES.get(fa, MARGIN_V2.get(fa, 0))))
    o.add("NSFirstAttribute", *b.int8(ATTRIBUTES.get(MARGIN_BASE.get(fa, fa), 0)))
    rel = RELATIONS.get(el.get("relation", "equal"))
    if rel is not None:
        o.add("NSRelation", *b.int8(rel))
    _add_multiplier(b, o, el)
    second = el.get("secondItem")
    if second is not None:
        o.add("NSSecondItem", *b.ref(id_map[second]))
        sa = el.get("secondAttribute")
        if sa is None:
            raise XibError(f"<constraint> secondItem without secondAttribute ({where})")
        o.add("NSSecondAttributeV2", *b.int8(ATTRIBUTES.get(sa, MARGIN_V2.get(sa, 0))))
        o.add("NSSecondAttribute", *b.int8(ATTRIBUTES.get(MARGIN_BASE.get(sa, sa), 0)))
    # Margin-attribute constraints carry a legacy NSConstant next to (or
    # instead of) NSConstantV2: the resolved offset in the pre-margin space.
    # Default margins are 8pt. A margin on the second item resolves +8 for
    # leading/top and -8 for trailing/bottom; on the first item the sign flips
    # (oracle probes m-base/m-exp2/m-expconst; app gold Settings + Inspector).
    legacy_offset = 0.0
    # Resolve each margin relative to the base attribute: second minus first.
    def margin_offset(attr):
        if attr in ("leadingMargin", "topMargin"):
            return 8.0
        return -8.0 if attr in ("bottomMargin", "trailingMargin") else 0.0
    first_offset = margin_offset(el.get("firstAttribute"))
    second_offset = margin_offset(el.get("secondAttribute"))
    margin = first_offset != 0.0 or second_offset != 0.0
    legacy_offset = second_offset - first_offset
    if el.get("symbolic") == "YES":
        o.add("NSSymbolicConstant", *b.ref(b.string("NSSpace")))
        o.add("NSShouldBeArchived", *b.boolean(False))
    elif el.get("constant") is not None:
        c = float(el.get("constant"))
        o.add("NSConstantV2", *b.float64(c))
        o.add("NSShouldBeArchived", *b.boolean(False))
        o.add("NSConstant", *b.float64(c + legacy_offset if margin else c))
    elif margin:
        o.add("NSShouldBeArchived", *b.boolean(False))
        o.add("NSConstant", *b.float64(legacy_offset))
    else:
        o.add("NSShouldBeArchived", *b.boolean(False))
    return o


# Apple's order of a view's constraints array (oracle probes, ibtool 27.0). Each
# constraint belongs to its first item, or to its second item when the first is
# the owner view. Layout-guide groups come first, then view groups by the
# distance of the item's frame origin from (0, 0), then by x. Inside a group:
# constraints to the owner view first (in OWNER_ORDER of the item's attribute,
# on iOS also when the owner's attribute differs: Xcode 27.1 probes), then the rest in OTHER_ORDER of the group item's attribute;
# ties by relation (<=, >=, =), then by the other item's subview index.
OWNER_ORDER = ("width", "height", "centerX", "centerY", "trailing", "leading", "bottom", "top")
OTHER_ORDER = ("centerX", "trailing", "leading", "centerY", "bottom", "top", "width", "height")
# macOS groups by the item's subview index (not frame distance), orders
# owner-branch ties by relation, and knows baseline (probe RenameSheet).
MAC_OTHER_ORDER = ("centerX", "trailing", "leading", "centerY", "bottom", "top",
                   "baseline", "firstBaseline", "width", "height")
RELATION_ORDER = {"lessThanOrEqual": 0, "greaterThanOrEqual": 1, "equal": 2}


def _constraint_order(view_el, cons, where, mac=False):
    owner = view_el.get("id")
    par = {}
    def _walk_par(e, aid):
        for ch in e:
            cid = ch.get("id")
            if cid:
                par[cid] = aid
                _walk_par(ch, cid)
            else:
                _walk_par(ch, aid)
    _walk_par(view_el, owner)
    sidx = {}
    def _walk_sidx(e):
        subs = e.find("subviews")
        if subs is not None:
            for i, ch in enumerate(subs):
                if ch.get("id"):
                    sidx[ch.get("id")] = i
                _walk_sidx(ch)
    _walk_sidx(view_el)

    def _gidx(item_id):
        """Group index; a grandchild sorts inside its direct-subview
        ancestor's group, after that ancestor's own constraints (golden
        SidebarView: Mnm to iyL is the last root constraint)."""
        if item_id in index:
            return index[item_id]
        if item_id in guides or item_id is None or item_id == owner:
            return -1
        anc, depth = item_id, 0
        while anc is not None and anc not in index:
            anc = par.get(anc)
            depth += 1
        if anc is None:
            raise XibError(f"no frame for item {item_id!r} ({where})")
        return index[anc] + depth / 10
    guides = [g.get("id") for g in view_el.findall("viewLayoutGuide")]
    subs = view_el.find("subviews")
    index, origin = {}, {}
    for i, sv in enumerate(subs if subs is not None else ()):
        index[sv.get("id")] = i
        r = sv.find("rect[@key='frame']")
        if r is not None:
            origin[sv.get("id")] = (float(r.get("x")), float(r.get("y")))
        elif sv.tag in FRAMELESS_TAGS:
            # no design-time frame: Apple places it at the origin (_frame)
            origin[sv.get("id")] = FRAMELESS_RECT[:2]

    def key(c):
        first, second = c.get("firstItem", owner), c.get("secondItem")
        fa, sa = c.get("firstAttribute"), c.get("secondAttribute")
        guide_item = first in guides and second is not None and second not in guides \
            and second != owner
        if guide_item and mac:
            item, attr = second, MARGIN_BASE.get(sa, sa)
            rel = RELATION_ORDER[c.get("relation", "equal")]
            return (index.get(item, -1), 2, OWNER_ORDER.index(attr), rel,
                    index.get(item, -1))
        if guide_item and not mac:
            # iOS: guide-firstItem constraints precede the origin-view group;
            # guide-secondItem constraints stay with their view item's group.
            # Ties inside the guide group use the item-side attribute and
            # document order (FeedCell bottom constraints).
            item, attr, other, oattr = first, sa, second, sa
            gkey = ((1, 0.0, 0.0) if origin.get(second) == (0.0, 0.0)
                    else (0, 0.0, 0.0))
        elif guide_item:
            # macOS (probe DetailView 5vz/pbD): the guide-firstItem constraint
            # sorts inside its second item's group, after the other-branch
            # constraints, by the second item's side attribute.
            item, attr, other, oattr = second, sa, first, fa
            x, y = origin.get(item, (0.0, 0.0))
            gkey = (1, math.hypot(x, y), x)
            rel = RELATION_ORDER[c.get("relation", "equal")]
            return gkey + (2, OWNER_ORDER.index(MARGIN_BASE.get(attr, attr)),
                           rel, index.get(item, -1))
        else:
            if second is None:
                item, attr, other, oattr = first, fa, None, None
            elif first == owner:
                # owner-first: sort by the other side's attribute with the margin
                # wrapper unwrapped (syncContent-labelBottom bottomMargin/bottom).
                item, attr, other, oattr = second, MARGIN_BASE.get(sa, sa), first, fa
            else:
                item, attr, other, oattr = first, fa, second, sa
            if item in guides:
                gkey = (1, 0.0, 0.0)
            elif item in origin:
                x, y = origin[item]
                gkey = (1, math.hypot(x, y), x) if not mac else (1, index.get(item, -1), 0)
            elif item == owner and other is None:
                gkey = (1, 0.0, 0.0) if not mac else (1, -1, 0)
            elif mac:
                # grandchild: group by its nearest direct-subview ancestor,
                # after that ancestor's own constraints (probe golden
                # SidebarView: Mnm to iyL sorts after the HZs group)
                anc, depth = item, 0
                while anc is not None and anc not in index:
                    anc = par.get(anc)
                    depth += 1
                if anc is None:
                    raise XibError(f"constraint {c.get('id')}: no frame for item "
                                   f"{item!r}; Apple's order unknown ({where})")
                gkey = (1, index[anc], depth)
            else:
                raise XibError(f"constraint {c.get('id')}: no frame for item {item!r}; "
                               f"Apple's order unknown ({where})")
        rel = RELATION_ORDER[c.get("relation", "equal")]
        # A constraint to the owner view on another attribute sorts with the
        # owner constraints too, by the item's attribute (iOS golden HelloWorld
        # LaunchScreen: label centerY = view bottom * 1/3 precedes the label's
        # leading constraint to the safe area). Unverified on macOS.
        if other == owner:
            if attr not in OWNER_ORDER or (mac and MARGIN_BASE.get(oattr, oattr) != attr):
                raise XibError(f"constraint {c.get('id')}: {attr}/{oattr} to the owner view; "
                               f"Apple's order unknown ({where})")
            if mac:
                # relation ties break before the attribute (probe RenameSheet:
                # the >= leading constraint precedes the equal trailing one)
                return (_gidx(item), 0, rel, OWNER_ORDER.index(attr), 0)
            return gkey + (0, OWNER_ORDER.index(attr), 0, 0)
        order = MAC_OTHER_ORDER if mac else OTHER_ORDER
        if attr not in order or (oattr is not None and oattr not in order):
            raise XibError(f"constraint {c.get('id')}: attribute {attr}/{oattr}; "
                           f"Apple's order unknown ({where})")
        other_idx = 0 if guide_item else index.get(other, -1)
        if mac:
            return (_gidx(item), 1, order.index(attr), rel, other_idx)
        return gkey + (1, OTHER_ORDER.index(attr), rel, other_idx)

    return sorted(cons, key=key)


def build_constraints_block(b, view_el, owner, id_map, where, guides=None, rel_int=None,
                            cell_const=None):
    """A view's <constraints> -> (NSMutableArray shell, constraint objects), in
    Apple's order. `guides` maps layout-guide ids to lazy ref makers (storyboard
    safe areas); `rel_int` overrides the NSRelation integer width (cell
    archives store int64, scene nibs int8); `cell_const` puts NSShouldBeArchived
    between NSConstantV2 and NSConstant (embedded prototype archives)."""
    if cell_const is None:
        cell_const = getattr(b, "cell_const", False)
    if cell_const and rel_int is None:
        rel_int = N.INT64
    arr = b.new("NSMutableArray")
    arr.add("NSInlinedValue", *b.boolean(False))
    els = _constraint_order(view_el, view_el.find("constraints").findall("constraint"), where)
    cons = []
    for c in els:
        if guides is None and rel_int is None and not cell_const:
            cons.append(build_constraint(b, c, owner, id_map, where))
        else:
            o = b.new("NSLayoutConstraint")
            first = c.get("firstItem")
            if guides is not None and first in guides:
                o.add("NSFirstItem", *guides[first](b))
            else:
                o.add("NSFirstItem", *b.ref(id_map[first] if first else owner))
            fa = c.get("firstAttribute")
            if fa is None:
                raise XibError(f"<constraint> missing firstAttribute ({where})")
            o.add("NSFirstAttributeV2", *b.int8(ATTRIBUTES.get(fa, MARGIN_V2.get(fa, 0))))
            o.add("NSFirstAttribute", *b.int8(ATTRIBUTES.get(MARGIN_BASE.get(fa, fa), 0)))
            rel = RELATIONS.get(c.get("relation", "equal"))
            if rel is not None:
                o.add("NSRelation", *(b.int8(rel) if rel_int is None else (rel_int, rel)))
            _add_multiplier(b, o, c)
            second = c.get("secondItem")
            if second is not None:
                if guides is not None and second in guides:
                    o.add("NSSecondItem", *guides[second](b))
                else:
                    o.add("NSSecondItem", *b.ref(id_map[second]))
                sa = c.get("secondAttribute")
                if sa is None:
                    raise XibError(f"<constraint> secondItem without secondAttribute ({where})")
                o.add("NSSecondAttributeV2", *b.int8(ATTRIBUTES.get(sa, MARGIN_V2.get(sa, 0))))
                o.add("NSSecondAttribute", *b.int8(ATTRIBUTES.get(MARGIN_BASE.get(sa, sa), 0)))
            if any(a in MARGIN_V2 for a in (fa, c.get("secondAttribute"))):
                raise XibError(f"<constraint> margin attributes unverified in storyboard "
                               f"guide scenes ({where})")
            if c.get("symbolic") == "YES":
                o.add("NSSymbolicConstant", *b.ref(b.string("NSSpace")))
                o.add("NSShouldBeArchived", *b.boolean(False))
            elif c.get("constant") is not None:
                const = float(c.get("constant"))
                o.add("NSConstantV2", *b.float64(const))
                o.add("NSShouldBeArchived", *b.boolean(False))
                o.add("NSConstant", *b.float64(const))
            else:
                o.add("NSShouldBeArchived", *b.boolean(False))
            cons.append(o)
    for c in cons:
        arr.add("UINibEncoderEmptyKey", *b.ref(c))
    return arr, cons


def _uda_build(b, el, target, resources, named):
    """<userDefinedRuntimeAttributes> -> UINibKeyValuePair objects (probe ins-uda)."""
    u = el.find("userDefinedRuntimeAttributes")
    if u is None:
        return []
    pairs = []
    for a in u.findall("userDefinedRuntimeAttribute"):
        t, kp = a.get("type"), a.get("keyPath")
        w = f"userDefinedRuntimeAttribute {kp!r}"
        p = b.new("UINibKeyValuePair")  # pair object before its value (golden)
        if t == "color":
            v = build_color_el(b, a.find("color[@key='value']"), w, resources, named)
        elif t == "image":
            if a.get("catalog") != "system":
                raise XibError(f"{w}: image needs catalog=system")
            v = b.image_placeholder(_attr(a, "value", w))
        elif t == "number":
            iv = a.find("integer[@key='value']")
            if iv is None:
                raise XibError(f"{w}: number needs <integer>")
            v = b.new("NSNumber")
            v.add("NS.intval", *b.int8(int(_attr(iv, "value", w))))
        elif t == "boolean":
            v = b.new("NSNumber")
            v.add("NS.intval", *b.int8(1 if a.get("value") == "YES" else 0))
        elif t == "string":
            v = b.string(_attr(a, "value", w))
        else:
            raise XibError(f"unsupported userDefinedRuntimeAttribute type {t!r} ({kp})")
        p.add("UIObject", *b.ref(target))
        p.add("UIValue", *b.ref(v))
        p.add("UIKeyPath", *b.ref(b.string(kp)))
        pairs.append(p)
    return pairs


def _uda_pairs(b, el, target, resources, named):
    """Deferred: collect (element, target); Apple encodes the pairs (and their
    value objects) after the connections (golden ins-button/ins-uda)."""
    if el.find("userDefinedRuntimeAttributes") is None:
        return []
    return [(el, target)]


def build_text_field(b, el, where, in_constraints=False):
    """<textField> -> UITextField (probe ins-textfield, golden Inspector nibs)."""
    _check_shape(el, where)
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UITextField")
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(_autoresizing_mask(el, where)))
    if (el.get("translatesAutoresizingMaskIntoConstraints") == "NO"
            and (in_constraints or el.find("constraints") is not None)):
        o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
              *b.boolean(False))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    ha = el.get("contentHorizontalAlignment", "center")
    if ha != "center":
        if ha != "left":
            raise XibError(f"<textField> contentHorizontalAlignment={ha!r} not supported ({where})")
        o.add("UIContentHorizontalAlignment", *b.int8(1))
    if el.get("adjustsFontForContentSizeCategory") is not None:
        o.add("UIAdjustsFontForContentSizeCategory", *b.boolean(False))
    o.add("UIFont", *b.ref(build_font(b, _sub(el, "fontDescription", where), where)))
    ph = el.get("placeholder")
    if ph is not None:
        pid = el.get("id")
        o.add("UIPlaceholder", *b.ref(_localizable(b, ph, f"{pid}.placeholder" if pid else None)))
    ta = el.get("textAlignment")
    if ta is not None and ta not in TEXT_ALIGNMENTS:
        raise XibError(f"<textField> textAlignment={ta!r} not supported ({where})")
    o.add("UITextAlignment", *b.int8(TEXT_ALIGNMENTS[ta] if ta else 0))
    o.add("UITextColor", *b.ref(build_color(b, "labelColor", where)))
    o.add("UIAdjustsFontSizeToFit", *b.boolean(False))
    o.add("UIMinimumFontSize", *b.float32(float(_attr(el, "minimumFontSize", where))))
    o.add("UIClearButtonOffset", *b.geom(3.0, 1.0))
    tit = el.find("*[@key='textInputTraits']")
    if tit is not None:
        act = tit.get("autocapitalizationType")
        if act is not None:
            if act != "words":
                raise XibError(f"<textInputTraits> autocapitalizationType={act!r} not supported ({where})")
            o.add("UIAutocapitalizationType", *b.int8(1))
    o.add("UIDisableTextColorUpdateOnTraitCollectionChange", *b.boolean(False))
    return o


def _button_font(b, el, where):
    fd = el.find("fontDescription[@key='fontDescription']")
    if fd is not None:
        return build_font(b, fd, where)
    return build_font(b, ET.Element("fontDescription", {"type": "system", "pointSize": "18"}), where)


def build_button(b, el, where, resources, named, in_constraints=False):
    """<button> -> UIButton, or UIClassSwapper for customClass buttons
    (probe ins-button, golden Inspector nibs). Returns (obj, cons_group, events)."""
    _check_shape(el, where)
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    cls = el.get("customClass")
    o = b.new("UIClassSwapper" if cls else "UIButton")
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(_autoresizing_mask(el, where)))
    if (el.get("translatesAutoresizingMaskIntoConstraints") == "NO"
            and (in_constraints or el.find("constraints") is not None)):
        o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
              *b.boolean(False))
    group = []
    cons_el = el.find("constraints")
    if cons_el is not None:
        arr, cons = build_constraints_block(b, el, o, {}, where)
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
        group.append(cons)
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    stateful = b.new("NSMutableDictionary")
    stateful.add("NSInlinedValue", *b.boolean(False))
    bid = el.get("id")
    for st in el.findall("state"):
        skey = _attr(st, "key", where)
        if skey not in BUTTON_STATES:
            raise XibError(f"<button> state {skey!r} not supported ({where})")
        sv = BUTTON_STATES[skey]
        num = b.state_nums.get(sv)
        if num is None:  # Apple pools the state number across all buttons
            num = b.new("NSNumber")
            num.add("NS.intval", *b.int8(sv))
            b.state_nums[sv] = num
        content = b.new("UIButtonContent")
        title = st.get("title")
        if title is not None:
            if skey != "normal":
                raise XibError(f"<button> title on state {skey!r} not supported ({where})")
            content.add("UITitle", *b.ref(_localizable(b, title, f"{bid}.normalTitle" if bid else None)))
        tc = st.find("color[@key='titleColor']")
        if tc is not None:
            content.add("UITitleColor", *b.ref(build_color_el(b, tc, where, resources, named)))
        stateful.add("UINibEncoderEmptyKey", *b.ref(num))
        stateful.add("UINibEncoderEmptyKey", *b.ref(content))
    o.add("UIButtonStatefulContent", *b.ref(stateful))
    o.add("UIAdjustsImageWhenHighlighted", *b.boolean(False))
    o.add("UIAdjustsImageWhenDisabled", *b.boolean(False))
    if not cls and el.get("buttonType") is not None:
        bt = el.get("buttonType")
        if bt != "system":
            raise XibError(f"<button> buttonType={bt!r} not supported ({where})")
        o.add("UIButtonType", *b.int8(1))
    o.add("UIFont", *b.ref(_button_font(b, el, where)))
    inset = el.find("inset[@key='imageEdgeInsets']")
    if inset is not None:
        if cls:
            raise XibError(f"<button> imageEdgeInsets on customClass button not supported ({where})")
        o.add("UIImageEdgeInsets", *b.geom(float(inset.get("minY", "0.0")),
                                           float(inset.get("minX", "0.0")),
                                           float(inset.get("maxY", "0.0")),
                                           float(inset.get("maxX", "0.0"))))  # UIEdgeInsets (top, left, bottom, right)
    o.add("UIButtonConfiguration", N.NIL, None)
    if cls:
        o.add("UIClassName", *b.ref(b.string(_swift_class(el))))
        o.add("UIOriginalClassName", *b.ref(b.string("UIButton")))
    events = []
    conns = el.find("connections")
    for ac in (conns.findall("action") if conns is not None else ()):
        sel = _attr(ac, "selector", where)
        events.append((sel, _attr(ac, "destination", where), ac.get("eventType"), o))
    return o, group, events


def build_stack_view(b, el, where, resources, named, id_map):
    """<stackView> -> UIStackView (probe ins-stack, golden Inspector nibs).
    Returns (obj, cons_group, events, pairs, deferred_kids)."""
    _check_shape(el, where)
    for attr, allowed in (("axis", {None: 0, "horizontal": 0}),
                          ("distribution", {None: 0, "fill": 0}),
                          ("alignment", {None: 0, "fill": 0})):
        v = el.get(attr)
        if v not in allowed:
            raise XibError(f"<stackView> {attr}={v!r} not supported ({where})")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UIStackView")
    if el.get("id"):
        id_map[el.get("id")] = o
    subs = b.new("NSMutableArray")  # after the stack object itself (golden order)
    subs.add("NSInlinedValue", *b.boolean(False))
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UISubviews", *b.ref(subs))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(_autoresizing_mask(el, where)))
    if el.get("translatesAutoresizingMaskIntoConstraints") == "NO":
        o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
              *b.boolean(False))
    o.add("UIViewLayoutMargins", *b.geom(0.0, 0.0, 0.0, 0.0))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    kids, events, pairs, groups = [], [], [], []
    subs_el = el.find("subviews")
    cons_el = el.find("constraints")
    referenced = set()
    for c in (cons_el.findall("constraint") if cons_el is not None else ()):
        for end in ("firstItem", "secondItem"):
            if c.get(end):
                referenced.add(c.get(end))
    allmap = dict(id_map)
    for child in (subs_el if subs_el is not None else ()):
        if child.get("id"):
            referenced.add(child.get("id"))  # arranged: flag always stored
        kid, kgroups, kevents, kpairs, kdeferred = _build_subview(
            b, child, where, resources, named, allmap, referenced)
        kids.append(kid)
        groups.extend(kgroups)
        events.extend(kevents)
        pairs.extend(kpairs)
        if kdeferred:
            groups.append(kdeferred)
    for k in kids:
        subs.add("UINibEncoderEmptyKey", *b.ref(k))
    # Apple creates the arranged array after the arranged subviews themselves.
    arranged = b.new("NSArray")
    arranged.add("NSInlinedValue", *b.boolean(False))
    for k in kids:
        arranged.add("UINibEncoderEmptyKey", *b.ref(k))
    o.add("UIStackViewArrangedSubviews", *b.ref(arranged))
    o.add("UIStackViewAxis", *b.int8(0))
    o.add("UIStackViewDistribution", *b.int8(0))
    o.add("UIStackViewAlignment", *b.int8(0))
    if el.get("spacing") is not None:
        o.add("UIStackViewSpacing", *b.float64(float(el.get("spacing"))))
    o.add("UIStackViewBaselineRelative", *b.boolean(True))
    o.add("UIStackViewLayoutMarginsRelative", *b.boolean(True))
    for k, v in allmap.items():
        id_map[k] = v
    group = []
    if cons_el is not None:
        arr, cons = build_constraints_block(b, el, o, {}, where)
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
        group.append(cons)
    # arranged kids decode after this stack's constraint group
    return o, group, events, pairs, groups + [kids] if kids else groups


def build_image_view(b, el, where, id_map, resources=None, named=None,
                     in_constraints=False):
