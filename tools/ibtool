    return o, group


def _safe_area_guide(b, owner_obj, cache):
    """The real safe-area guide: owning view set, four system constraints
    (top/left/bottom/right) created inline (ContextMenu/JEX goldens)."""
    g = b.new("UILayoutGuide")
    g.add("UILayoutGuideOwningView", *b.ref(owner_obj))
    g.add("UILayoutGuideIdentifier", *b.ref(b.string("UIViewSafeAreaLayoutGuide")))
    g.add("UILayoutGuideOwningViewIsLocked", *b.boolean(False))
    g.add("UILayoutGuideShouldBeArchived", *b.boolean(False))
    g.add("UILayoutGuideAllowsNegativeDimensions", *b.boolean(False))
    arr = b.new("NSArray")
    arr.add("NSInlinedValue", *b.boolean(False))
    g.add("UILayoutGuideSystemConstraints", *b.ref(arr))
    for ident, flip in (("top", False), ("left", False),
                        ("bottom", True), ("right", True)):
        c = b.new("NSLayoutConstraint")
        if not flip:
            c.add("NSFirstItem", *b.ref(g))
            c.add("NSFirstAttributeV2", *b.int8(ATTRIBUTES[ident]))
            c.add("NSFirstAttribute", *b.int8(ATTRIBUTES[ident]))
            c.add("NSSecondItem", *b.ref(owner_obj))
        else:
            c.add("NSFirstItem", *b.ref(owner_obj))
            c.add("NSFirstAttributeV2", *b.int8(ATTRIBUTES[ident]))
            c.add("NSFirstAttribute", *b.int8(ATTRIBUTES[ident]))
            c.add("NSSecondItem", *b.ref(g))
        c.add("NSSecondAttributeV2", *b.int8(ATTRIBUTES[ident]))
        c.add("NSSecondAttribute", *b.int8(ATTRIBUTES[ident]))
        c.add("NSShouldBeArchived", *b.boolean(True))
        c.add("NSLayoutIdentifier",
              *b.ref(b.string(f"UIViewSafeAreaLayoutGuide-{ident}")))
        arr.add("UINibEncoderEmptyKey", *b.ref(c))
    cache.append(g)
    return g


