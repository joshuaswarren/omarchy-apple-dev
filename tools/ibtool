def _scene_image_view(sb, el, where, resources, named, id_map):
    """Storyboard imageView: no UIOpaque (FeedCell header golden); tint before
    DoesNotTranslate; image and preferredSymbolConfiguration last."""
    b = sb.b
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UIImageView")
    if el.get("id"):
        id_map[el.get("id")] = o
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    if el.get("userInteractionEnabled") is not None:
        o.add("UIUserInteractionDisabled", *b.boolean(el.get("userInteractionEnabled") != "NO"))
    if el.get("multipleTouchEnabled") is not None:
        if el.get("userInteractionEnabled") is not None:
            raise XibError("<imageView> with both userInteractionEnabled and multipleTouchEnabled: "
                           f"Apple's key order unknown ({where})")
        # stored inverted, like UIClipsToBounds (Runner LaunchScreen golden)
        o.add("UIMultipleTouchEnabled", *b.boolean(el.get("multipleTouchEnabled") != "YES"))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(_autoresizing_mask(el, where)))
    cm = el.get("contentMode")
    if cm is not None and cm != "scaleToFill":
        if cm not in CONTENT_MODES:
            raise XibError(f"<imageView> contentMode={cm!r} not supported ({where})")
        o.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
    if el.get("clipsSubviews") is not None:
        o.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
    tint = el.find("color[@key='tintColor']")
    if tint is not None:
        o.add("UITintColor", *b.ref(build_color_el(b, tint, where, resources, named)))
    tr = el.get("translatesAutoresizingMaskIntoConstraints")
    if tr is not None:
        o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
              *b.boolean(tr != "NO"))
    group = []
    if el.find("constraints") is not None:
        arr, cons = build_constraints_block(b, el, o, id_map, where)
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
        group.append(cons)
    if el.get("horizontalHuggingPriority") is not None:
        hug = f"{{{_attr(el, 'horizontalHuggingPriority', where)}, {_attr(el, 'verticalHuggingPriority', where)}}}"
        o.add("UIViewContentHuggingPriority", *b.ref(b.string(hug)))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    img = el.find("imageReference[@key='image']")
    if img is not None:
        o.add("UIImage", *b.ref(_image_ref(b, img, where)))
    elif el.get("image") is not None:
        # image="Name": an asset-catalog image named by attribute (Runner
        # LaunchScreen golden). The placeholder is 1 x 1 whatever the document's
        # <image> resource says.
        if el.get("catalog") is not None:
            raise XibError(f"<imageView image=... catalog={el.get('catalog')!r}> "
                           f"not supported in a scene ({where})")
        ph = b.new("UIImageNibPlaceholder")
        ph.add("UIImageWidth", *b.float32(1.0))
        ph.add("UIImageHeight", *b.float32(1.0))
        ph.add("UIResourceName", *b.ref(b.string(el.get("image"))))
        ph.add("UISystemSymbolResourceName", N.NIL, None)
        ph.add("UISymbolImageConfiguration", N.NIL, None)
        ph.add("UIResourceCatalogName", N.NIL, None)
        o.add("UIImage", *b.ref(ph))
    psym = _symbol_config(b, el, "preferredSymbolConfiguration", where)
    if psym is not None:
        o.add("UIPreferredSymbolConfiguration", *b.ref(psym))
    return o, group


