def self_test():
    import glob
    import tempfile
    global TARGET_MODULE
    failed = []
    compiled = []
    nibs = sorted(p for p in glob.glob(os.path.join(GOLDEN, "**", "*.nib"), recursive=True)
                  if os.path.isfile(p))
    for p in nibs:
        raw = open(p, "rb").read()
        if N.encode(N.parse(raw)) != raw:
            failed.append(f"round-trip {os.path.basename(p)}")
    for src in sorted(glob.glob(os.path.join(_TOOLS, "..", "tests", "ibtool",
                                             "src-mac", "**", "*.xib"),
                                recursive=True)):
        name = os.path.splitext(os.path.basename(src))[0]
        global TARGET_MODULE
        TARGET_MODULE = "NetNewsWire"
        out = compile_xib(src)
        want = open(os.path.join(_TOOLS, "..", "tests", "ibtool", "golden-mac",
                                 f"{name}.nib"), "rb").read()
        if out != want:
            diff = next((i for i, (x, y) in enumerate(zip(out, want)) if x != y),
                        min(len(out), len(want)))
            failed.append(f"mac {name}.nib: {len(out)} vs {len(want)} bytes, "
                          f"first diff at {diff}")
        compiled.append(name)
    for name in SELF_TEST_NIBS:
        src = os.path.join(SRC, f"{name}.xib")
        if not os.path.isfile(src):
            src = os.path.join(SRC, "NetNewsWire", f"{name}.xib")
        # The NNW goldens were compiled with --module NetNewsWire, as Xcode does.
        TARGET_MODULE = "NetNewsWire" if "/NetNewsWire/" in src else None
        out = compile_xib(src)
        want = open(os.path.join(GOLDEN, f"{name}.nib"), "rb").read()
        if out != want:
            diff = next((i for i, (x, y) in enumerate(zip(out, want)) if x != y),
                        min(len(out), len(want)))
            failed.append(f"{name}.nib: {len(out)} vs {len(want)} bytes, first diff at {diff}")
        compiled.append(name)
    for label, src_rel, golden_rel in SB_SELF_TEST:
        TARGET_MODULE = "NetNewsWire" if src_rel.startswith("NetNewsWire/") else None
        tmp = tempfile.mkdtemp(prefix="/tmp/ibtool-sbtest-")
        dirpart = os.path.dirname(golden_rel)
        # The module segment: Mastodon/Base.lproj -> Mastodon, HelloWorld ->
        # HelloWorld; NetNewsWire's legacy Base.lproj or top level -> none.
        top = dirpart.split("/")[0]
        module = top if top and not top.endswith(".lproj") else ""
        sbc = compile_storyboard(os.path.join(SRC, src_rel),
                                 os.path.join(tmp, "stage", dirpart))
        # Apple's --link nests only the .lproj parent under OUT; the module
        # segment comes from OUT itself (as compile-golden.sh does).
        out_root = os.path.join(tmp, "out", module)
        link_storyboards(out_root, [sbc])
        mine = _tree_bytes(out_root)
        cut = len(module) + 1 if module else 0
        stripped = golden_rel[cut:]
        prefix = stripped + "/"
        want = {k[cut:]: v for k, v in _tree_bytes(GOLDEN).items()
                if k.startswith((module + "/" if module else "") + prefix)}
        if mine == want:
            compiled.append(label)
        else:
            detail = [f"{k}: {'missing' if k not in mine else 'differs' if k in want else 'extra'}"
                      for k in sorted(set(mine) | set(want))
                      if mine.get(k) != want.get(k)]
            failed.append(f"{label}: {detail}")
    global MIN_DEPLOYMENT
    for label, src_rel, golden_rel, target in PRE17_SELF_TEST:
        TARGET_MODULE = None
        tmp = tempfile.mkdtemp(prefix="/tmp/ibtool-sbtest-")
        MIN_DEPLOYMENT = target
        try:
            sbc = compile_storyboard(os.path.join(SRC, src_rel), tmp)
        finally:
            MIN_DEPLOYMENT = None
        want = open(os.path.join(_TOOLS, "..", "tests", "ibtool", "golden-pre17", golden_rel),
                    "rb").read()
        mine_path = os.path.join(sbc, os.path.basename(golden_rel))
        if os.path.isfile(mine_path) and open(mine_path, "rb").read() == want:
            compiled.append(label)
        else:
            failed.append(f"{label}: {os.path.basename(golden_rel)} differs")
    if failed:
        raise SystemExit("self-test FAILED: " + "; ".join(failed))
    print(f"self-test passed (round-trip {len(nibs)} golden nibs; "
          f"{' and '.join(compiled)} byte-identical to golden)")


def _swift_module(module, argv):
    """SwiftPM compiles a target's IB files in its resource bundle, whose module is
    '<package>_<target>'; the custom classes live in the target's own Swift module.
    SwiftBuild's intermediate paths (.../Intermediates.noindex/<package>.build/...) name
    the package, so the target is what follows '<package>_'."""
    for a in argv:
        parts = a.split(os.sep)
        if "Intermediates.noindex" in parts[:-1]:
            pkg = parts[parts.index("Intermediates.noindex") + 1].removesuffix(".build")
            if module.startswith(pkg + "_"):
                target = module[len(pkg) + 1:]
                m = "".join(c if c.isascii() and (c.isalnum() or c == "_") else "_" for c in target)
                return "_" + m if m[:1].isdigit() else m
    return module


def main(argv):
    if "--version" in argv:
        sys.stdout.write(VERSION_XML)
        return 0
    if "--self-test" in argv:
        self_test()
        return 0
    flags_with_value = {"--module", "--output-partial-info-plist",
                        "--minimum-deployment-target", "--output-format",
                        "--compilation-directory", "--target-device"}
    known_flags = flags_with_value | {"--errors", "--warnings",
                                      "--notices", "--auto-activate-custom-fonts",
                                      "--compile", "--link"}
    global TARGET_MODULE, MIN_DEPLOYMENT
    if "--module" in argv[:-1]:
        TARGET_MODULE = _swift_module(argv[argv.index("--module") + 1], argv)
    if "--minimum-deployment-target" in argv[:-1]:
        MIN_DEPLOYMENT = _deployment_target(argv[argv.index("--minimum-deployment-target") + 1])
    action = None
    action_args = []
    positional = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--compile" or a == "--link":
            action = a
            action_args = argv[i + 1:]
            break
        if a in flags_with_value:
            i += 2
            continue
        if a in known_flags:
            i += 1
            continue
        if a.endswith(".storyboard"):
            positional.append(a)
            i += 1
            continue
        print(f"error: ibtool: unknown argument {a!r}", file=sys.stderr)
        return 2

    def partial_plist():
        for j, a in enumerate(argv):
            if a == "--output-partial-info-plist":
                p = argv[j + 1]
                os.makedirs(os.path.dirname(os.path.abspath(p)), exist_ok=True)
                with open(p, "wb") as f:
                    plistlib.dump({}, f)

    def comp_dir():
        for j, a in enumerate(argv):
            if a == "--compilation-directory":
                return argv[j + 1]
        return None

    if positional and not action:
        # CompileStoryboard: ibtool [flags] IN.storyboard --compilation-directory DIR
        if len(positional) != 1 or not comp_dir():
            print("error: ibtool: storyboard compile needs one .storyboard and "
                  "--compilation-directory", file=sys.stderr)
            return 2
        try:
            sbc = compile_storyboard(positional[0], comp_dir())
        except (XibError, ET.ParseError) as e:
            print(f"error: ibtool: {e}", file=sys.stderr)
            return 1
        partial_plist()
        print(f"/* {sbc} */", file=sys.stderr)
        return 0
    if action == "--compile":
        if len(action_args) != 2:
            print("error: ibtool: --compile needs OUT.nib and IN.xib", file=sys.stderr)
            return 2
        out, xib = action_args
        try:
            data = compile_xib(xib)
        except (XibError, ET.ParseError) as e:
            print(f"error: ibtool: {e}", file=sys.stderr)
            return 1
        partial_plist()
        tmp = out + ".tmp-nibarchive"
        with open(tmp, "wb") as f:
            f.write(data)
        os.replace(tmp, out)  # no partial output on failure
        return 0
    if action == "--link":
        # LinkStoryboards: ibtool [flags] --link OUT SRC.storyboardc...
        if len(action_args) < 2:
            print("error: ibtool: --link needs OUT and at least one .storyboardc",
                  file=sys.stderr)
            return 2
        out, sources = action_args[0], action_args[1:]
        try:
            link_storyboards(out, sources)
        except OSError as e:
            print(f"error: ibtool: {e}", file=sys.stderr)
            return 1
        return 0
    print("error: ibtool: no action given (expected --compile, --link, a "
          ".storyboard input, or --version)",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
