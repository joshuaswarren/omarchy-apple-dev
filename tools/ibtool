def _scene_collection_view(sb, el, where, resources, named, id_map, state):
    """<collectionView>: scroll keys + UIDelegate slot + flow layout; prototype
    cells compile to embedded archives on the root collection view (6Bn)."""
    b = sb.b
    _check_shape(el, where)
    if el.get("dataMode") not in (None, "prototypes"):
        raise XibError(f"<collectionView> dataMode={el.get('dataMode')!r} unsupported ({where})")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UICollectionView")
    if el.get("id"):
        id_map[el.get("id")] = o
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    bg = el.find("color[@key='backgroundColor']")
    if bg is not None:
        o.add("UIBackgroundColor", *b.ref(build_color_el(b, bg, where, resources, named)))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIOpaque", *b.boolean(False))
    mt = _bool_key(el, "multipleTouchEnabled")
    if mt is not None:
        o.add("UIMultipleTouchEnabled", *b.boolean(mt))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(_autoresizing_mask(el, where)))
    o.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
    tint = el.find("color[@key='tintColor']")
    if tint is not None:
        o.add("UITintColor", *b.ref(build_color_el(b, tint, where, resources, named)))
    tr = el.get("translatesAutoresizingMaskIntoConstraints")
    if tr is not None:
        o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
              *b.boolean(tr != "NO"))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    o.add("UIScrollViewIndicatorInsetAdjustmentBehavior", *b.int8(1))
    o.add("UIBouncesZoom", *b.boolean(False))
    o.add("UIDelegate", N.NIL, None)
    o.add("UIScrollViewContentInsetAdjustmentBehavior", *b.int8(0))
    flow = el.find("collectionViewFlowLayout[@key='collectionViewLayout']")
    if flow is not None:
        fobj = _flow_layout(sb, flow, where)
        o.add("UICollectionLayout", *b.ref(fobj))
        state.setdefault("extras", []).append((el, fobj))
    o.add("UIAllowsUserInitiatedMultipleSelection", *b.boolean(False))
    cells = el.find("cells")
    header = el.find("collectionReusableView")
    if (cells is not None and len(cells)) or header is not None:
        cell_els = cells.findall("collectionViewCell") if cells is not None else ()
        cell_keys = [_attr(c, "reuseIdentifier", where) for c in cell_els]

        def ext_dict(keys):
            d = b.new("NSMutableDictionary")
            d.add("NSInlinedValue", *b.boolean(False))
            for k in keys:
                d.add("UINibEncoderEmptyKey", *b.ref(b.string(k)))
                e = b.new("NSMutableDictionary")
                e.add("NSInlinedValue", *b.boolean(False))
                d.add("UINibEncoderEmptyKey", *b.ref(e))
            return d

        proto_ext = ext_dict(cell_keys)
        o.add("UICollectionViewCellPrototypeNibExternalObjects", *b.ref(proto_ext))
        hkey = None
        if header is not None:
            hkey = f"UICollectionElementKindSectionHeader/{_attr(header, 'reuseIdentifier', where)}"
            supp_ext = ext_dict([hkey])
            o.add("UICollectionViewSupplementaryViewPrototypeNibExternalObjects", *b.ref(supp_ext))
        cell_dict = b.new("NSMutableDictionary")
        cell_dict.add("NSInlinedValue", *b.boolean(False))
        for k, c in zip(cell_keys, cell_els):
            cell_dict.add("UINibEncoderEmptyKey", *b.ref(b.string(k)))
            cell_dict.add("UINibEncoderEmptyKey",
                          *b.ref(_prototype_nib(b, c, where, resources, named)))
        o.add("UICollectionViewCellNibDict", *b.ref(cell_dict))
        if header is not None:
            supp_dict = b.new("NSMutableDictionary")
            supp_dict.add("NSInlinedValue", *b.boolean(False))
            supp_dict.add("UINibEncoderEmptyKey", *b.ref(b.string(hkey)))
            supp_dict.add("UINibEncoderEmptyKey",
                          *b.ref(_prototype_nib(b, header, where, resources, named)))
            o.add("UICollectionViewSupplementaryViewNibDict", *b.ref(supp_dict))
    if el.get("prefetchingEnabled") not in (None, "NO"):
        raise XibError(f"<collectionView> prefetchingEnabled={el.get('prefetchingEnabled')!r} unsupported ({where})")
    o.add("UICollectionViewPrefetchingEnabled",
          *b.boolean(el.get("prefetchingEnabled") == "NO"))
    if el.find("viewLayoutGuide") is not None:
        state.setdefault("scroll_guides", []).append(el)
    state.setdefault("owners", []).append((el, o))
    return o, [], []


def _deployment_target(text):
    """'16.6' -> (16, 6); None when it is not a version."""
    parts = text.split(".")
    if not all(p.isdigit() for p in parts) or not parts:
        return None
    return (int(parts[0]), int(parts[1]) if len(parts) > 1 else 0)


LEGACY_GUIDE_IDENT = {"top": "_UIViewControllerTop", "bottom": "_UIViewControllerBottom"}


def _legacy_layout_guide(b, g_el, view, where):
    """One <viewControllerLayoutGuide> of a scene's <layoutGuides> (the pre-safe-area
    top/bottom guides) -> (guide, constraints the view owns). The guide is a hidden
    subview of the scene view with one support constraint of its own; the view
    carries three constraints per guide, which the guide also lists as the ones
    to remove (Runner Main and LaunchScreen goldens)."""
    kind = g_el.get("type")
    if kind not in LEGACY_GUIDE_IDENT:
        raise XibError(f"<viewControllerLayoutGuide> type={kind!r} not supported ({where})")
    unknown = set(g_el.attrib) - {"type", "id"}
    if unknown or len(g_el):
        raise XibError(f"<viewControllerLayoutGuide> has unsupported content ({where})")
    g = b.new("_UILayoutGuide")
    own = b.new("NSMutableArray")
    support = b.new("_UILayoutSupportConstraint")
    ident = b.string(LEGACY_GUIDE_IDENT[kind])
    remove = b.new("NSArray")

    def constraint(first, first_attr, second=None, second_attr=None):
        c = b.new("NSLayoutConstraint")
        c.add("NSFirstItem", *b.ref(first))
        c.add("NSFirstAttributeV2", *b.int8(ATTRIBUTES[first_attr]))
        c.add("NSFirstAttribute", *b.int8(ATTRIBUTES[first_attr]))
        if second is not None:
            c.add("NSSecondItem", *b.ref(second))
            c.add("NSSecondAttributeV2", *b.int8(ATTRIBUTES[second_attr]))
            c.add("NSSecondAttribute", *b.int8(ATTRIBUTES[second_attr]))
        c.add("NSShouldBeArchived", *b.boolean(False))
        return c

    if kind == "top":
        cons = [constraint(g, "leading", view, "leading"),
                constraint(g, "top", view, "top"),
                constraint(g, "height")]
    else:
        cons = [constraint(g, "leading", view, "leading"),
                constraint(g, "height"),
                constraint(view, "bottom", g, "bottom")]
    g.add("UIDeepDrawRect", *b.boolean(False))
    g.add("UIOpaque", *b.boolean(False))
    g.add("UIHidden", *b.boolean(False))
    g.add("UIAutoresizeSubviews", *b.boolean(False))
    g.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints", *b.boolean(False))
    g.add("UIViewAutolayoutConstraints", *b.ref(own))
    g.add("UIViewSemanticContentAttribute", *b.int8(0))
    g.add("UIViewLargeContentStoredProperties", N.NIL, None)
    g.add("_UILayoutGuideIdentifier", *b.ref(ident))
    g.add("_UILayoutGuideConstraintsToRemove", *b.ref(remove))
    own.add("NSInlinedValue", *b.boolean(False))
    own.add("UINibEncoderEmptyKey", *b.ref(support))
    support.add("NSFirstItem", *b.ref(g))
    support.add("NSFirstAttributeV2", *b.int8(ATTRIBUTES["width"]))
    support.add("NSFirstAttribute", *b.int8(ATTRIBUTES["width"]))
    support.add("NSShouldBeArchived", *b.boolean(False))
    support.add("NSPriority", *b.int16(999))
    remove.add("NSInlinedValue", *b.boolean(False))
    for c in cons:
        remove.add("UINibEncoderEmptyKey", *b.ref(c))
    return g, cons


def _scene_element(sb, el, where, resources, named, id_map, state):
    """One scene element -> (obj, own_constraint_group, events)."""
    state.setdefault("id_map", {}).update({k: v for k, v in id_map.items()})
    b = sb.b
    tag = el.tag
    cls = el.get("customClass")
    if tag == "label":
        kid, lgroup = build_label(b, el, where, resources, named)
        if el.get("id"):
            id_map[el.get("id")] = kid
        return kid, lgroup, []
    if tag == "imageView":
        kid, group = _scene_image_view(sb, el, where, resources, named, id_map)
        return kid, group, []
    if tag == "slider":
        return build_slider(b, el, where, id_map, named), [], []
    if tag == "button":
        kid, group, events = _scene_button(sb, el, where, resources, named, id_map)
        if el.get("id"):
            id_map[el.get("id")] = kid
        return kid, group, events
    if tag == "visualEffectView":
        kid, group = _scene_visual_effect_view(sb, el, where, id_map, state)
        return kid, group, []
    if tag == "scrollView":
        return _scene_scroll_view(sb, el, where, id_map, state)
    if tag == "collectionView":
        return _scene_collection_view(sb, el, where, resources, named, id_map, state)
    if tag != "view":
        raise XibError(f"unsupported subview <{tag}> ({where})")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UIClassSwapper" if cls else "UIView")
    if el.get("id"):
        id_map[el.get("id")] = o
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    subs_el = el.find("subviews")
    slot = None
    subs = None
    # the scene's legacy top/bottom layout guides live in its root view
    legacy_els = state.get("legacy_guides", ()) if state.get("legacy_root") is el else ()
    if subs_el is not None or legacy_els:
        subs = b.new("NSMutableArray")
        subs.add("NSInlinedValue", *b.boolean(False))
        o.add("UISubviews", *b.ref(subs))
        slot = len(o.values)
    kids, groups, _ex = _build_kids(sb, el, where, resources, named, id_map, state)
    if subs is not None:
        for k in kids:
            subs.add("UINibEncoderEmptyKey", *b.ref(k))
    legacy_cons = []
    for g_el in legacy_els:
        g_obj, g_cons = _legacy_layout_guide(b, g_el, o, where)
        subs.add("UINibEncoderEmptyKey", *b.ref(g_obj))
        legacy_cons.extend(g_cons)
        state.setdefault("legacy_guide_objs", []).append(g_obj)
        if g_el.get("id"):
            id_map[g_el.get("id")] = g_obj
    color = el.find("color[@key='backgroundColor']")
    if color is not None:
        cobj = build_color_el(b, color, where, resources, named)
        o.values.insert(slot if slot is not None else 2,
                        ("UIBackgroundColor", N.Value(0, N.OBJREF, cobj.idx)))
    _view_common(b, el, o, where, resources, named, slot)
    group = []
    gid_el = el.find("viewLayoutGuide[@key='safeArea']")
    cache = []
    guides = {}
    if gid_el is not None:
        # the real guide (system constraints, UIViewLayoutGuides array) is
        # archived only when a constraint references it; otherwise the guide
        # appears solely as a decode-list placeholder (LaunchScreen golden)
        gid = gid_el.get("id")
        referenced = any(
            c.get("firstItem") == gid or c.get("secondItem") == gid
            for c in (el.find("constraints").findall("constraint")
                      if el.find("constraints") is not None else ()))
        if referenced:
            guides[gid] = _guide_maker(o, cache)
    if el.find("constraints") is not None:
        arr, cons = build_constraints_block(b, el, o, id_map, where, guides)
        # the guides' constraints come first in the view's list
        for i, c in enumerate(legacy_cons):
            arr.values.insert(1 + i, ("UINibEncoderEmptyKey", N.Value(0, N.OBJREF, c.idx)))
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
        group.append(cons)
        ordered_els = _constraint_order(el, el.find("constraints").findall("constraint"), where)
        for c_el, c_obj in zip(ordered_els, cons):
            if c_el.get("id"):
                state.setdefault("id_map", {})[c_el.get("id")] = c_obj
    elif legacy_cons:
        arr = b.new("NSMutableArray")
        arr.add("NSInlinedValue", *b.boolean(False))
        for c in legacy_cons:
            arr.add("UINibEncoderEmptyKey", *b.ref(c))
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
    if cache:
        garr = b.new("NSMutableArray")
        garr.add("NSInlinedValue", *b.boolean(False))
        garr.add("UINibEncoderEmptyKey", *b.ref(cache[0]))
        o.add("UIViewLayoutGuides", *b.ref(garr))
    if el.get("insetsLayoutMarginsFromSafeArea") is not None:
        o.add("UIViewInsetsLayoutMarginsFromSafeArea", *b.int8(0))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    if cls:
        o.add("UIClassName", *b.ref(b.string(_swift_class(el))))
        o.add("UIOriginalClassName", *b.ref(b.string("UIView")))
    return o, group, []


def _prototype_nib(b, el, where, resources, named):
    """A collectionViewCell / collectionReusableView prototype compiled into an
    embedded NIBArchive (FeedCell/Folder/header goldens)."""
    data = _prototype_archive(el, where, resources, named)
    obj = b.new("UINib")
    obj.add("captureEnclosingNIBBundleOnDecode", *b.boolean(False))
    d = b.new("NSData")
    d.add("NS.bytes", N.DATA, data)
    obj.add("archiveData", *b.ref(d))
    return obj


def _outlets_of(el, id_map, where):
    out = []
    conns = el.find("connections")
    for oc in (conns.findall("outlet") if conns is not None else ()):
        prop = _attr(oc, "property", where)
        dst = id_map.get(oc.get("destination"))
        if dst is None:
            raise XibError(f"unroutable outlet {oc.attrib} ({where})")
        out.append((prop, dst))
    return out


def _events_under(el, id_map, where):
    """Control <action> connections anywhere under this element, sorted by
    selector (VC-nib events sort; single-sample)."""
    out = []
    for node in el.iter("action"):
        sel = _attr(node, "selector", where)
        dst = id_map.get(node.get("destination"))
        if dst is None:
            raise XibError(f"unroutable action {sel!r} ({where})")
        et = node.get("eventType", "touchUpInside")
        if et not in EVENT_MASKS:
            raise XibError(f"eventType {et!r} unsupported ({where})")
        out.append((sel, EVENT_MASKS[et], dst))
    return sorted(out)


def _prototype_archive(el, where, resources, named):
    """[FO, FR, swapper] nib for one prototype. Cells wrap a
    collectionViewCellContentView with four system pin constraints; reusable
    views carry their own subviews and constraints."""
    is_cell = el.tag == "collectionViewCell"
    _check_shape(el, where)
    sb = _Scene()
    b = sb.b
    b.cell_const = True
    root = b.new("NSObject")
    top = b.new("NSArray")
    fo = _proxy(b, "IBFilesOwner")
    fr = _proxy(b, "IBFirstResponder")
    x, y, w, h = _frame(el)
    (_, _, _, _), (cx, cy) = _bounds_center(el)
    if not el.get("customClass"):
        raise XibError(f"<{el.tag}> requires customClass ({where})")
    cell = b.new("UIClassSwapper")
    cell.add("UIBounds", *b.geom(0.0, 0.0, w, h))
    cell.add("UICenter", *b.geom(cx, cy))
    subs = b.new("NSMutableArray")
    subs.add("NSInlinedValue", *b.boolean(False))
    cell.add("UISubviews", *b.ref(subs))
    # UIBackgroundColor sits right after UISubviews in the swapper values, but
    # the UIColor object is created later (after the content-view guides) —
    # placeholder now, backfilled where the color is built (6Bn goldens).
    has_bg = el.find("color[@key='backgroundColor']") is not None
    if has_bg:
        cell.add("UIBackgroundColor", N.NIL, None)
    id_map = {el.get("id"): cell}
    state = {}
    decode = []
    if is_cell:
        content = el.find("collectionViewCellContentView[@key='contentView']")
        if content is None:
            raise XibError(f"<collectionViewCell> has no contentView ({where})")
        _check_shape(content, where)
        (cbx, cby, cbw, cbh), (ccx, ccy) = _bounds_center(content)
        cv = b.new("UIView")
        if content.get("id"):
            id_map[content.get("id")] = cv
        cv.add("UIBounds", *b.geom(cbx, cby, cbw, cbh))
        cv.add("UICenter", *b.geom(ccx, ccy))
        cvsubs = b.new("NSMutableArray")
        cvsubs.add("NSInlinedValue", *b.boolean(False))
        cv.add("UISubviews", *b.ref(cvsubs))
        gid = content.find("viewLayoutGuide")
        cache = []
        guides = {gid.get("id"): _guide_maker(cv, cache)} if gid is not None else {}
        ckids, cgroups, _ex = _build_kids(sb, content, where, resources, named,
                                          id_map, state)
        for k in ckids:
            cvsubs.add("UINibEncoderEmptyKey", *b.ref(k))
        cv.add("UIDeepDrawRect", *b.boolean(False))
        mt = _bool_key(content, "multipleTouchEnabled")
        if mt is not None:
            cv.add("UIMultipleTouchEnabled", *b.boolean(mt))
        cv.add("UIAutoresizeSubviews", *b.boolean(False))
        cmask = _autoresizing_mask(content, where, default=0)
        if cmask:
            cv.add("UIAutoresizingMask", *b.int8(cmask))
        cm = content.get("contentMode")
        if cm is not None and cm != "scaleToFill":
            cv.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
        cv.add("UIClipsToBounds", *b.boolean(content.get("clipsSubviews") != "YES"))
        cv.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
              *b.boolean(content.get("translatesAutoresizingMaskIntoConstraints")
                         == "YES"))
        own = []
        if content.find("constraints") is not None:
            arr, cons = build_constraints_block(b, content, cv, id_map, where,
                                                guides, rel_int=N.INT64,
                                                cell_const=True)
            cv.add("UIViewAutolayoutConstraints", *b.ref(arr))
            own = cons
        if gid is not None:
            garr = b.new("NSMutableArray")
            garr.add("NSInlinedValue", *b.boolean(False))
            garr.add("UINibEncoderEmptyKey", *b.ref(cache[0]))
            cv.add("UIViewLayoutGuides", *b.ref(garr))
        if content.get("insetsLayoutMarginsFromSafeArea") is not None:
            cv.add("UIViewInsetsLayoutMarginsFromSafeArea", *b.int8(0))
        cv.add("UIViewSemanticContentAttribute", *b.int8(0))
        cv.add("UIViewLargeContentStoredProperties", N.NIL, None)
        cell.add("UIDeepDrawRect", *b.boolean(False))
        mt = _bool_key(el, "multipleTouchEnabled")
        if mt is not None:
            cell.add("UIMultipleTouchEnabled", *b.boolean(mt))
        cell.add("UIAutoresizeSubviews", *b.boolean(False))
        cell.add("UIAutoresizingMask", *b.int8(_autoresizing_mask(el, where)))
        cm = el.get("contentMode")
        if cm is not None and cm != "scaleToFill":
            cell.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
        cell.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
        bg = el.find("color[@key='backgroundColor']")
        if bg is not None:
            col = build_color_el(b, bg, where, resources, named)
            for i, (k, _v) in enumerate(cell.values):
                if k == "UIBackgroundColor":
                    cell.values[i] = (k, N.Value(0, N.OBJREF, col.idx))
        sysarr = b.new("NSMutableArray")
        sysarr.add("NSInlinedValue", *b.boolean(False))
        cell.add("UIViewAutolayoutConstraints", *b.ref(sysarr))
        ident_str = None
        for attr in ("leading", "trailing", "top", "bottom"):
            c = b.new("NSLayoutConstraint")
            c.add("NSFirstItem", *b.ref(cell))
            c.add("NSFirstAttributeV2", *b.int8(ATTRIBUTES[attr]))
            c.add("NSFirstAttribute", *b.int8(ATTRIBUTES[attr]))
            c.add("NSSecondItem", *b.ref(cv))
            c.add("NSSecondAttributeV2", *b.int8(ATTRIBUTES[attr]))
            c.add("NSSecondAttribute", *b.int8(ATTRIBUTES[attr]))
            c.add("NSShouldBeArchived", *b.boolean(False))
            if ident_str is None:
                ident_str = b.string("UIIBSystemGenerated")
            c.add("NSLayoutIdentifier", *b.ref(ident_str))
            sysarr.add("UINibEncoderEmptyKey", *b.ref(c))
        cell.add("UIViewSemanticContentAttribute", *b.int8(0))
        cell.add("UIViewLargeContentStoredProperties", N.NIL, None)
        cell.add("UIReuseIdentifier", *b.ref(b.string(_attr(el, "reuseIdentifier", where))))
        cell.add("UISystemBackgroundView", N.NIL, None)
        cell.add("UIContentConfigurationView", N.NIL, None)
        cell.add("UIContentView", *b.ref(cv))
        cell.add("UIClassName", *b.ref(b.string(_swift_class(el))))
        cell.add("UIOriginalClassName", *b.ref(b.string("UICollectionViewCell")))
        subs.add("UINibEncoderEmptyKey", *b.ref(cv))
        decode = [fo, fr, cell, cv] + ([lambda bb: _guide_ph(bb)] if gid is not None else []) + \
            own + ckids + [c0 for g in cgroups for c0 in g]
    else:
        kids, groups, _ex = _build_kids(sb, el, where, resources, named, id_map, state)
        for k in kids:
            subs.add("UINibEncoderEmptyKey", *b.ref(k))
        cell.add("UIDeepDrawRect", *b.boolean(False))
        mt = _bool_key(el, "multipleTouchEnabled")
        if mt is not None:
            cell.add("UIMultipleTouchEnabled", *b.boolean(mt))
        cell.add("UIAutoresizeSubviews", *b.boolean(False))
        cell.add("UIAutoresizingMask", *b.int8(_autoresizing_mask(el, where)))
        cm = el.get("contentMode")
        if cm is not None and cm != "scaleToFill":
            cell.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
        cell.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
        bg = el.find("color[@key='backgroundColor']")
        if bg is not None:
            col = build_color_el(b, bg, where, resources, named)
            for i, (k, _v) in enumerate(cell.values):
                if k == "UIBackgroundColor":
                    cell.values[i] = (k, N.Value(0, N.OBJREF, col.idx))
        own = []
        gid = el.find("viewLayoutGuide")
        cache = []
        guides = {gid.get("id"): _guide_maker(cell, cache)} if gid is not None else {}
        if el.find("constraints") is not None:
            arr, cons = build_constraints_block(b, el, cell, id_map, where, guides,
                                                cell_const=True)
            cell.add("UIViewAutolayoutConstraints", *b.ref(arr))
            own = cons
        if gid is not None:
            garr = b.new("NSMutableArray")
            garr.add("NSInlinedValue", *b.boolean(False))
            garr.add("UINibEncoderEmptyKey", *b.ref(cache[0]))
            cell.add("UIViewLayoutGuides", *b.ref(garr))
        cell.add("UIViewSemanticContentAttribute", *b.int8(0))
        cell.add("UIViewLargeContentStoredProperties", N.NIL, None)
        cell.add("UIReuseIdentifier", *b.ref(b.string(_attr(el, "reuseIdentifier", where))))
        cell.add("UIClassName", *b.ref(b.string(_swift_class(el))))
        cell.add("UIOriginalClassName", *b.ref(b.string("UICollectionReusableView")))
        decode = [fo, fr, cell] + ([lambda bb: _guide_ph(bb)] if gid is not None else []) + \
            own + kids + [c0 for g in groups for c0 in g]
    objarr = b.new("NSArray")
    objarr.add("NSInlinedValue", *b.boolean(False))
    for x0 in decode:
        objarr.add("UINibEncoderEmptyKey",
                   *b.ref(x0(b) if callable(x0) else x0))
    conn_arr = b.new("NSArray")
    conn_arr.add("NSInlinedValue", *b.boolean(False))
    for prop, dst in _outlets_of(el, id_map, where):
        c = b.new("UIRuntimeOutletConnection")
        c.add("UILabel", *b.ref(b.string(prop)))
        c.add("UISource", *b.ref(cell))
        c.add("UIDestination", *b.ref(dst))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    for sel, mask, dst in _events_under(el, id_map, where):
        c = b.new("UIRuntimeEventConnection")
        c.add("UILabel", *b.ref(b.string(sel)))
        c.add("UISource", *b.ref(id_map[_event_source(el, sel)]))
        c.add("UIDestination", *b.ref(dst))
        c.add("UIEventMask", *b.int_fit(mask))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    empty = sb.empty_array()
    top.add("NSInlinedValue", *b.boolean(False))
    for x0 in (fo, fr, cell):
        top.add("UINibEncoderEmptyKey", *b.ref(x0))
    root.add("UINibTopLevelObjectsKey", *b.ref(top))
    root.add("UINibObjectsKey", *b.ref(objarr))
    root.add("UINibConnectionsKey", *b.ref(conn_arr))
    for key in ("UINibVisibleWindowsKey", "UINibAccessibilityConfigurationsKey",
                "UINibTraitStorageListsKey", "UINibKeyValuePairsKey"):
        root.add(key, *b.ref(empty))
    root.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root)


def _event_source(el, sel):
    """The element whose <connections> carries this action (used for UISource)."""
    result = [None]

    def walk(e):
        for child in e:
            conns = child.find("connections")
            if conns is not None and any(
                    a.get("selector") == sel for a in conns.findall("action")):
                result[0] = child
            walk(child)
    walk(el)
    return result[0].get("id") if result[0] is not None else el.get("id")


LARGE_TITLE_MODES = {"automatic": 0, "never": 2}
SYSTEM_ITEMS = {"done": 0, "flexibleSpace": 5}
SPLIT_DISPLAY_MODES = {"beside": 2}
SPLIT_BEHAVIORS = {"tile": 1}
SPLIT_BACKGROUND_STYLES = {"sidebar": 1}
SPLIT_RELATIONSHIPS = ("masterViewController", "supplementaryViewController",
                       "detailViewController")


def _bar_button_item(sb, el, where):
    """<barButtonItem>: title/image items and system items (Article golden;
    systemItem="done" stores UIStyle 2 for style="done", else 1)."""
    b = sb.b
    o = b.new("UIBarButtonItem")
    if el.get("enabled") != "NO":
        o.add("UIEnabled", *b.boolean(False))
    system = el.get("systemItem")
    if system is not None:
        if system not in SYSTEM_ITEMS or set(el.attrib) - {"key", "style", "systemItem", "id"} \
                or (system == "flexibleSpace") != (el.get("style") == "plain"):
            raise XibError(f"<barButtonItem> systemItem={system!r} unsupported ({where})")
        o.add("UIIsSystemItem", *b.boolean(False))
        o.add("UISystemItem", *b.int8(SYSTEM_ITEMS[system]))
        if system == "flexibleSpace":
            o.add("UIHidesSharedBG", *b.boolean(False))
        else:
            o.add("UIStyle", *b.int8(2 if el.get("style") == "done" else 1))
        return o
    if el.get("style") not in (None, "plain"):
        raise XibError(f"<barButtonItem> style={el.get('style')!r} unsupported ({where})")
    o.add("UIStyle", *b.int8(1))
    if el.get("title") is not None:
        iid = el.get("id")
        o.add("UITitle", *b.ref(_localizable(b, el.get("title"),
                                             f"{iid}.title" if iid else None)))
    if el.get("image") is not None:
        img = b.new("UIImageNibPlaceholder")
        catalog = el.get("catalog") == "system"
        if catalog:
            img.add("UIImageWidth", *b.float32(0.0))
            img.add("UIImageHeight", *b.float32(0.0))
        else:
            img.add("UIImageWidth", *b.float32(1.0))
            img.add("UIImageHeight", *b.float32(1.0))
        img.add("UIResourceName", *b.ref(b.string(el.get("image"))))
        if catalog:
            img.add("UISystemSymbolResourceName", *b.ref(b.string(el.get("image"))))
        else:
            img.add("UISystemSymbolResourceName", N.NIL, None)
        img.add("UISymbolImageConfiguration", N.NIL, None)
        img.add("UIResourceCatalogName", N.NIL, None)
        o.add("UIImage", *b.ref(img))
    return o


def _has_uda(el):
    return el.find("userDefinedRuntimeAttributes") is not None


def _nav_item(sb, el, where):
    """<navigationItem>: title (+attributed mirror), left/right items, shared
    empty center groups, large-title mode (Article/RootSplit/Settings goldens).
    Returns (item, [(element, bar item)]) with the left item first."""
    if set(el.attrib) - {"key", "title", "id", "largeTitleDisplayMode"}:
        raise XibError(f"<navigationItem> attributes {dict(el.attrib)} not supported ({where})")
    b = sb.b
    o = b.new("UINavigationItem")
    title = el.get("title")
    if title is not None:
        tref = b.ref(_localizable(b, title, f"{el.get('id')}.title"))
        o.add("UITitle", *tref)
        at = b.new("NSAttributedString")
        at.add("NSString", *tref)
        attrs = b.new("NSDictionary")
        attrs.add("NSInlinedValue", *b.boolean(False))
        at.add("NSAttributes", *b.ref(attrs))
        o.add("UIAttributedTitle", *b.ref(at))
    left_el = el.find("barButtonItem[@key='leftBarButtonItem']")
    left = _bar_button_item(sb, left_el, where) if left_el is not None else None
    if left is not None and _has_uda(left_el):
        raise XibError(f"leftBarButtonItem runtime attributes unsupported ({where})")
    if left is not None:
        o.add("UILeftBarButtonItem", *b.ref(left))
    right_els = []
    ritems = el.find("rightBarButtonItems")
    if ritems is not None:
        right_els = ritems.findall("barButtonItem")
    single = el.find("barButtonItem[@key='rightBarButtonItem']")
    if single is not None:
        right_els = [single]
    right_objs = []
    if right_els:
        first = _bar_button_item(sb, right_els[0], where)
        right_objs.append(first)
        o.add("UIRightBarButtonItem", *b.ref(first))
    if left is not None:
        arr = b.new("NSArray")
        arr.add("NSInlinedValue", *b.boolean(False))
        arr.add("UINibEncoderEmptyKey", *b.ref(left))
        o.add("UILeftBarButtonItems", *b.ref(arr))
    o.add("UICenterItemGroups", *b.ref(sb.empty_array()))
    if right_els:
        arr = b.new("NSArray")
        arr.add("NSInlinedValue", *b.boolean(False))
        arr.add("UINibEncoderEmptyKey", *b.ref(first))
        for item in right_els[1:]:
            obj = _bar_button_item(sb, item, where)
            right_objs.append(obj)
            arr.add("UINibEncoderEmptyKey", *b.ref(obj))
        o.add("UIRightBarButtonItems", *b.ref(arr))
    mode = el.get("largeTitleDisplayMode")
    if mode is not None:
        if mode not in LARGE_TITLE_MODES:
            raise XibError(f"<navigationItem> largeTitleDisplayMode={mode!r} "
                           f"unsupported ({where})")
        o.add("UILargeTitleDisplayMode", *b.int8(LARGE_TITLE_MODES[mode]))
    else:
        o.add("UILargeTitleDisplayMode", *b.int8(0))
    return o, ([(left_el, left)] if left is not None else []) + list(zip(right_els, right_objs))


def _toolbar_array(sb, vc_el, where):
    """<toolbarItems> -> (array object, [(element, object)])."""
    b = sb.b
    arr = b.new("NSArray")
    arr.add("NSInlinedValue", *b.boolean(False))
    made = []
    tel = vc_el.find("toolbarItems")
    for item in (tel.findall("barButtonItem") if tel is not None else ()):
        obj = _bar_button_item(sb, item, where)
        made.append((item, obj))
        arr.add("UINibEncoderEmptyKey", *b.ref(obj))
    return arr, made


def _view_nib_name(vc_el):
    view = vc_el.find("*[@key='view']")
    if view is None or not view.get("id") or not vc_el.get("id"):
        raise XibError(f"scene view controller has no keyed view ({vc_el.get('id')})")
    return f"{vc_el.get('id')}-view-{view.get('id')}"


def _vc_swapper_values(sb, swapper, vc_el, where, parent_ref):
    """The VC swapper value sequence shared by standalone scene nibs and split
    children (Article/Feeds/Timeline/ImageVC goldens). Returns a dict with the
    created pieces for decode-list and connection assembly."""
    b = sb.b
    made = {"toolbar": [], "nav_items": [], "nav_obj": None, "nav_el": None,
            "vc": vc_el, "nibName_sort": _view_nib_name(vc_el)}
    if vc_el.get("title") is not None:
        swapper.add("UITitle", *b.ref(_localizable(
            b, vc_el.get("title"), f"{vc_el.get('id')}.title")))
    nav = vc_el.find("navigationItem[@key='navigationItem']")
    if nav is not None:
        nobj, nav_items = _nav_item(sb, nav, where)
        made["nav_obj"] = nobj
        made["nav_el"] = nav
        made["nav_items"] = nav_items
        swapper.add("UINavigationItem", *b.ref(nobj))
    ext = b.new("NSDictionary")
    ext.add("NSInlinedValue", *b.boolean(False))
    made["ext"] = ext
    if _vc_has_upstream(vc_el):
        ext.add("UINibEncoderEmptyKey", *b.ref(b.string("UpstreamPlaceholder-1")))
        ext.add("UINibEncoderEmptyKey", *b.ref(swapper))
    swapper.add("UIExternalObjectsTableForViewLoading", *b.ref(ext))
    ident = vc_el.get("storyboardIdentifier")
    name = ident or f"UIViewController-{vc_el.get('id')}"
    swapper.add("UINibName", *b.ref(b.string(_view_nib_name(vc_el))))
    if ident:
        s = b.string(ident)
        swapper.add("UIStoryboardIdentifier", *b.ref(s))
        if vc_el.get("useStoryboardIdentifierAsRestorationIdentifier") == "YES":
            swapper.add("UIRestorationIdentifier", *b.ref(s))
    if parent_ref is not None:
        swapper.add("UIParentViewController", *parent_ref)
    if vc_el.find("toolbarItems") is not None:
        arr, made["toolbar"] = _toolbar_array(sb, vc_el, where)
        swapper.add("UIToolbarItems", *b.ref(arr))
    if vc_el.get("extendedLayoutIncludesOpaqueBars") is not None:
        if vc_el.get("extendedLayoutIncludesOpaqueBars") != "YES":
            raise XibError(f"extendedLayoutIncludesOpaqueBars unsupported ({where})")
        swapper.add("UIKeyExtendedLayoutIncludesOpaqueBars", *b.int8(1))
    if vc_el.get("clearsSelectionOnViewWillAppear") is not None:
        if vc_el.get("clearsSelectionOnViewWillAppear") != "NO":
            raise XibError(f"clearsSelectionOnViewWillAppear unsupported ({where})")
        swapper.add("UIClearsSelectionOnViewWillAppear", *b.boolean(True))
    orig = VC_ORIGINAL_CLASS[vc_el.tag]
    swapper.add("UIClassName", *b.ref(b.string(_swift_class(vc_el) or orig)))
    swapper.add("UIOriginalClassName", *b.ref(b.string(orig)))
    made["name"] = name
    return made


def _vc_has_upstream(vc_el):
    """True when the view nib needs the Upstream placeholder: any outlet or
    action that crosses between the VC and the view tree (including
    constraint outlets, Article golden searchBarBottomConstraint)."""
    view = vc_el.find("*[@key='view']")
    if view is None:
        return False
    inside = {e.get("id") for e in view.iter() if e.get("id")}
    for c in view.iter("constraints"):
        inside |= {c2.get("id") for c2 in c.findall("constraint") if c2.get("id")}
    for oc in view.findall("connections/outlet"):
        if oc.get("destination") == vc_el.get("id"):
            return True
    for node in view.iter("action"):
        if node.get("destination") == vc_el.get("id"):
            return True
    conns = vc_el.find("connections")
    for oc in (conns.findall("outlet") if conns is not None else ()):
        if oc.get("destination") in inside:
            return True
    return False


def _kvp_item_order(vc_el, split_children=None):
    """Emit order of bar-item elements carrying runtime attributes.

    Split-children nibs (RootSplit golden): toolbar groups first, then
    navigation groups, children in reverse creation order, document order
    within a group. Standalone scene nibs (Article golden + probes q1-q4):
    document order, except the last toolbar attribute item rotates to the
    front when the toolbar holds >=5 attribute items or a flexible space
    precedes its last attribute item.
    """
    def items_of(vc):
        tel = vc.find("toolbarItems")
        raw = (tel.findall("barButtonItem") if tel is not None else ())
        tool = [i for i in raw if _has_uda(i)]
        nav = vc.find("navigationItem[@key='navigationItem']")
        navs = []
        if nav is not None:
            ri = nav.find("rightBarButtonItems")
            for i in (ri.findall("barButtonItem") if ri is not None else ()):
                if _has_uda(i):
                    navs.append(i)
            single = nav.find("barButtonItem[@key='rightBarButtonItem']")
            if single is not None and _has_uda(single):
                navs.append(single)
        return raw, tool, navs

    if split_children is not None:
        out = []
        for kind in (1, 2):
            for vc in reversed(split_children):
                out.extend(items_of(vc)[kind])
        return out
    raw, tool, navs = items_of(vc_el)
    if not tool:
        return navs
    last = raw.index(tool[-1])
    flex_before_last = any(i.get("systemItem") is not None for i in raw[:last])
    if len(tool) >= 5 or flex_before_last:
        return [tool[-1]] + navs + tool[:-1]
    return tool + navs


def _scene_vc_nib(vc_el, where, resources, named):
    """Scene VC nib -> (bytes, nib name)."""
    sb = _Scene()
    b = sb.b
    root = b.new("NSObject")
    top = b.new("NSArray")
    fo = _proxy(b, "IBFilesOwner")
    fr = _proxy(b, "IBFirstResponder")
    sbph = _proxy(b, "UIStoryboardPlaceholder")
    swapper = b.new("UIClassSwapper")
    made = _vc_swapper_values(sb, swapper, vc_el, where, None)
    top.add("NSInlinedValue", *b.boolean(False))
    for x in (fo, fr, sbph, swapper):
        top.add("UINibEncoderEmptyKey", *b.ref(x))
    decode = [fo, fr, sbph, swapper]
    if made["nav_obj"] is not None:
        decode.append(made["nav_obj"])
    decode.extend(obj for _el, obj in made["toolbar"])
    decode.extend(obj for _el, obj in made["nav_items"])
    objarr = b.new("NSArray")
    objarr.add("NSInlinedValue", *b.boolean(False))
    for x in decode:
        objarr.add("UINibEncoderEmptyKey", *b.ref(x))
    # connections: storyboard pinned first, then outlets sorted with
    # sceneViewController woven in, then events sorted by selector
    conn_arr = b.new("NSArray")
    conn_arr.add("NSInlinedValue", *b.boolean(False))
    c1 = b.new("UIRuntimeOutletConnection")
    c1.add("UILabel", *b.ref(b.string("storyboard")))
    c1.add("UISource", *b.ref(swapper))
    c1.add("UIDestination", *b.ref(sbph))
    conn_arr.add("UINibEncoderEmptyKey", *b.ref(c1))
    outlet_targets = {}
    for _el, obj in made["toolbar"] + made["nav_items"]:
        if _el.get("id"):
            outlet_targets[_el.get("id")] = obj
    outlets = []
    conns = vc_el.find("connections")
    for oc in (conns.findall("outlet") if conns is not None else ()):
        dst = outlet_targets.get(oc.get("destination"))
        if dst is None:
            continue  # targets in the view nib
        outlets.append((oc.get("property"), swapper, dst))
    labels = sorted(p for p, _s, _d in outlets) + ["sceneViewController"]
    for label in labels:
        c = b.new("UIRuntimeOutletConnection")
        c.add("UILabel", *b.ref(b.string(label)))
        if label == "sceneViewController":
            c.add("UISource", *b.ref(fo))
            c.add("UIDestination", *b.ref(swapper))
        else:
            _p, src, dst = next(o for o in outlets if o[0] == label)
            c.add("UISource", *b.ref(src))
            c.add("UIDestination", *b.ref(dst))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    events = []
    for el, obj in made["toolbar"] + made["nav_items"]:
        conns = el.find("connections")
        for ac in (conns.findall("action") if conns is not None else ()):
            if ac.get("destination") != vc_el.get("id"):
                raise XibError(f"action destination outside scene ({where})")
            events.append((_attr(ac, "selector", where), obj))
    for sel, src in sorted(events):
        c = b.new("UIRuntimeEventConnection")
        c.add("UILabel", *b.ref(b.string(sel)))
        c.add("UISource", *b.ref(src))
        c.add("UIDestination", *b.ref(swapper))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    empty = sb.empty_array()
    root.add("UINibTopLevelObjectsKey", *b.ref(top))
    root.add("UINibObjectsKey", *b.ref(objarr))
    root.add("UINibConnectionsKey", *b.ref(conn_arr))
    for key in ("UINibVisibleWindowsKey", "UINibAccessibilityConfigurationsKey",
                "UINibTraitStorageListsKey"):
        root.add(key, *b.ref(empty))
    # key-value pairs: bar item runtime attributes in the verified order
    item_map = {}
    for el, obj in made["toolbar"] + made["nav_items"]:
        if el.get("id"):
            item_map[el.get("id")] = obj
    ordered = _kvp_item_order(vc_el)
    for el in ordered:
        if _has_uda(el):
            sb.pairs.append((el, item_map[el.get("id")]))
    kvp = sb.emit_pairs()
    if kvp is not None:
        root.add("UINibKeyValuePairsKey", *b.ref(kvp))
    else:
        root.add("UINibKeyValuePairsKey", *b.ref(empty))
    root.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root), made["name"]


def _scene_split_nib(split_el, children, where, resources, named):
    """A splitViewController scene: one nib holding the split swapper and every
    child VC swapper (RootSplit golden). Children arrive in relationship order
    (master, supplementary, detail). Returns (bytes, split name)."""
    sb = _Scene()
    b = sb.b
    root = b.new("NSObject")
    top = b.new("NSArray")
    by_id = {child.get("id"): child for child in children}
    segue_ids = [s.get("destination") for s in reversed(split_el.findall("./connections/segue"))]
    top_children = [by_id[sid] for sid in segue_ids if sid in by_id]
    top_children.extend(child for child in children if child not in top_children)
    ph_by_id = {child.get("id"): _proxy(b, "UIStoryboardPlaceholder")
                for child in top_children}
    top_phs = [ph_by_id[child.get("id")] for child in top_children]
    child_phs = [ph_by_id[child.get("id")] for child in children]
    fo = _proxy(b, "IBFilesOwner")
    fr = _proxy(b, "IBFirstResponder")
    split_ph = _proxy(b, "UIStoryboardPlaceholder")
    ident = split_el.get("storyboardIdentifier")
    name = ident or f"UISplitViewController-{split_el.get('id')}"
    split = b.new("UIClassSwapper")
    if ident:
        split.add("UIStoryboardIdentifier", *b.ref(b.string(ident)))
    child_arr = b.new("NSMutableArray")
    child_arr.add("NSInlinedValue", *b.boolean(False))
    split.add("UIChildViewControllers", *b.ref(child_arr))
    if split_el.get("extendedLayoutIncludesOpaqueBars") is not None:
        if split_el.get("extendedLayoutIncludesOpaqueBars") != "YES":
            raise XibError(f"extendedLayoutIncludesOpaqueBars unsupported ({where})")
        split.add("UIKeyExtendedLayoutIncludesOpaqueBars", *b.int8(1))
    if split_el.get("allowDoubleColumnStyle") is not None:
        if split_el.get("allowDoubleColumnStyle") != "YES":
            raise XibError(f"allowDoubleColumnStyle unsupported ({where})")
        split.add("UISplitViewControllerStyle", *b.int8(2))
    split.add("UISplitViewControllerPrimaryEdge", *b.int8(0))
    style = split_el.get("primaryBackgroundStyle")
    if style is not None:
        if style not in SPLIT_BACKGROUND_STYLES:
            raise XibError(f"primaryBackgroundStyle={style!r} unsupported ({where})")
        split.add("UISplitViewControllerPrimaryBackgroundStyle",
                  *b.int8(SPLIT_BACKGROUND_STYLES[style]))
    mode = split_el.get("preferredDisplayMode")
    if mode is not None:
        if mode not in SPLIT_DISPLAY_MODES:
            raise XibError(f"preferredDisplayMode={mode!r} unsupported ({where})")
        split.add("UISplitViewControllerPreferredDisplayMode",
                  *b.int8(SPLIT_DISPLAY_MODES[mode]))
    behavior = split_el.get("behavior")
    if behavior is not None:
        if behavior not in SPLIT_BEHAVIORS:
            raise XibError(f"behavior={behavior!r} unsupported ({where})")
        split.add("UISplitViewControllerPreferredSplitBehavior",
                  *b.int8(SPLIT_BEHAVIORS[behavior]))
    made_children = []
    for child, ph in zip(children, child_phs):
        swapper = b.new("UIClassSwapper")
        made = _vc_swapper_values(sb, swapper, child, where, b.ref(split))
        made["ph"] = ph
        made["swapper"] = swapper
        made_children.append(made)
        child_arr.add("UINibEncoderEmptyKey", *b.ref(swapper))
    split.add("UIClassName", *b.ref(b.string(_swift_class(split_el)
                                             or "UISplitViewController")))
    split.add("UIOriginalClassName", *b.ref(b.string("UISplitViewController")))
    top.add("NSInlinedValue", *b.boolean(False))
    for x in top_phs + [fo, fr, split_ph, split]:
        top.add("UINibEncoderEmptyKey", *b.ref(x))
    # decode: children sorted by storyboard identifier (missing last), each with
    # nav + toolbar items, then right items per child in the same order
    order = sorted(range(len(made_children)),
                   key=lambda i: (children[i].get("storyboardIdentifier") is None,
                                  children[i].get("storyboardIdentifier") or ""))
    objarr = b.new("NSArray")
    objarr.add("NSInlinedValue", *b.boolean(False))
    decode = top_phs + [fo, fr, split_ph, split]
    for i in order:
        decode.append(made_children[i]["swapper"])
    for i in order:
        m = made_children[i]
        if m["nav_obj"] is not None:
            decode.append(m["nav_obj"])
        decode.extend(obj for _el, obj in m["toolbar"])
    for i in order:
        decode.extend(obj for _el, obj in made_children[i]["nav_items"])
    for x in decode:
        objarr.add("UINibEncoderEmptyKey", *b.ref(x))
    conn_arr = b.new("NSArray")
    conn_arr.add("NSInlinedValue", *b.boolean(False))
    c = b.new("UIRuntimeOutletConnection")
    c.add("UILabel", *b.ref(b.string("storyboard")))
    c.add("UISource", *b.ref(split))
    c.add("UIDestination", *b.ref(split_ph))
    conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    # child storyboard connections sort by the child's view-nib name (golden:
    # 6Bn Feeds, JEX Article, QJM Timeline)
    for m in sorted(made_children, key=lambda m: m["nibName_sort"]):
        c = b.new("UIRuntimeOutletConnection")
        c.add("UILabel", *b.ref(b.string("storyboard")))
        c.add("UISource", *b.ref(m["swapper"]))
        c.add("UIDestination", *b.ref(m["ph"]))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    outlet_map = {}
    for m in made_children:
        for el, obj in m["toolbar"] + m["nav_items"]:
            if el.get("id"):
                outlet_map[el.get("id")] = obj
    outlets = []
    for m in made_children:
        vc = m["vc"]
        conns = vc.find("connections")
        for oc in (conns.findall("outlet") if conns is not None else ()):
            dst = outlet_map.get(oc.get("destination"))
            if dst is None:
                continue
            outlets.append((oc.get("property"), m["swapper"], dst))
    for label in sorted([p for p, _s, _d in outlets]) + ["sceneViewController"]:
        c = b.new("UIRuntimeOutletConnection")
        c.add("UILabel", *b.ref(b.string(label)))
        if label == "sceneViewController":
            c.add("UISource", *b.ref(fo))
            c.add("UIDestination", *b.ref(split))
        else:
            _p, src, dst = next(o for o in outlets if o[0] == label)
            c.add("UISource", *b.ref(src))
            c.add("UIDestination", *b.ref(dst))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    events = []
    for m in made_children:
        for el, obj in m["toolbar"] + m["nav_items"]:
            conns = el.find("connections")
            for ac in (conns.findall("action") if conns is not None else ()):
                if ac.get("destination") != m["vc"].get("id"):
                    raise XibError(f"action destination outside scene ({where})")
                events.append((_attr(ac, "selector", where), obj, m["swapper"]))
    for sel, src, dst in sorted(events):
        c = b.new("UIRuntimeEventConnection")
        c.add("UILabel", *b.ref(b.string(sel)))
        c.add("UISource", *b.ref(src))
        c.add("UIDestination", *b.ref(dst))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    empty = sb.empty_array()
    root.add("UINibTopLevelObjectsKey", *b.ref(top))
    root.add("UINibObjectsKey", *b.ref(objarr))
    root.add("UINibConnectionsKey", *b.ref(conn_arr))
    for key in ("UINibVisibleWindowsKey", "UINibAccessibilityConfigurationsKey",
                "UINibTraitStorageListsKey"):
        root.add(key, *b.ref(empty))
    item_map = {}
    for m in made_children:
        for el, obj in m["toolbar"] + m["nav_items"]:
            if el.get("id"):
                item_map[el.get("id")] = obj
    for el in _kvp_item_order(None, split_children=children):
        if _has_uda(el):
            sb.pairs.append((el, item_map[el.get("id")]))
    kvp = sb.emit_pairs()
    if kvp is not None:
        root.add("UINibKeyValuePairsKey", *b.ref(kvp))
    else:
        root.add("UINibKeyValuePairsKey", *b.ref(empty))
    root.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root), name


def _split_relationship_children(split_el, where):
    """Child VCs in relationship order (master, supplementary, detail)."""
    conns = split_el.find("connections")
    if conns is None:
        raise XibError(f"<splitViewController> needs relationship segues ({where})")
    rel = {}
    for sg in conns.findall("segue"):
        if sg.get("kind") != "relationship" or sg.get("relationship") not in SPLIT_RELATIONSHIPS \
                or sg.get("relationship") in rel:
            raise XibError(f"<splitViewController> segue {dict(sg.attrib)} unsupported ({where})")
        rel[sg.get("relationship")] = sg.get("destination")
    return [rel[r] for r in SPLIT_RELATIONSHIPS if r in rel]


def _scene_view_nib(vc_el, root_el, where, resources, named, device=None):
    """<vcId>-view-<viewId>.nib: [FO, FR, (Upstream), view]. Decode order:
    view, root guide placeholders, root constraints, subviews, subview scroll
    placeholders, subview constraint groups, visual-effect content views
    (ContextMenu/6Bn/vO9 goldens)."""
    sb = _Scene()
    b = sb.b
    root = b.new("NSObject")
    top = b.new("NSArray")
    fo = _proxy(b, "IBFilesOwner")
    fr = _proxy(b, "IBFirstResponder")
    vc_id = vc_el.get("id")
    state = {"device": device}
    up = _proxy(b, "UpstreamPlaceholder-1") if _vc_has_upstream(vc_el) else None
    all_ids = state.setdefault("id_map", {})
    guides_el = vc_el.find("layoutGuides")
    if guides_el is not None:
        if root_el.tag != "view":
            raise XibError(f"<layoutGuides> on a <{root_el.tag}> scene not supported ({where})")
        other = [g.tag for g in guides_el if g.tag != "viewControllerLayoutGuide"]
        if other:
            raise XibError(f"<layoutGuides> has unsupported {sorted(set(other))} ({where})")
        state["legacy_root"] = root_el
        state["legacy_guides"] = list(guides_el)
    view, groups, events = _scene_element(sb, root_el, where, resources, named,
                                          all_ids, state)
    if device is None and root_el.tag in FRAMELESS_TAGS \
            and root_el.find("rect[@key='frame']") is None \
            and MIN_DEPLOYMENT is not None and MIN_DEPLOYMENT < (17, 0):
        # Below iOS 17 a scene view saved without a frame takes the default
        # device's size instead of 1000 x 1000; its subviews keep 1000 x 1000
        # (Runner LaunchScreen compiled at 13.0, 15.0 and 16.6 against 17.0 and 26.0).
        device = PRE_17_FRAMELESS_SCENE_SIZE
    if device is not None and \
            vc_el.find("freeformSimulatedSizeMetrics") is None:
        w, h = device
        for i, (k, v) in enumerate(view.values):
            if k == "UIBounds":
                view.values[i] = (k, N.Value(0, *b.geom(0.0, 0.0, w, h)))
            if k == "UICenter":
                view.values[i] = (k, N.Value(0, *b.geom(w / 2, h / 2)))
    tops = [fo, fr] + ([up] if up else []) + [view]
    top.add("NSInlinedValue", *b.boolean(False))
    for x in tops:
        top.add("UINibEncoderEmptyKey", *b.ref(x))
    decode = tops[:]
    extras = [(el_, x) for el_, x in state.get("extras", [])]
    for el_, x in extras:
        if el_ is root_el:
            decode.append(x)
    for _g in root_el.findall("viewLayoutGuide"):
        decode.append(lambda bb: _guide_ph(bb))
    for cons in groups:
        decode.extend(cons)
    decode.extend(state.get("legacy_guide_objs", []))
    kid_ph_els = [el for el in state.get("scroll_guides", []) if el is not root_el]
    for kid, _g in state.get("kid_decode", []):
        decode.append(kid)
    for el_, x in extras:
        if el_ is not root_el:
            decode.append(x)
    for el in kid_ph_els:
        for _g in el.findall("viewLayoutGuide"):
            decode.append(lambda bb: _guide_ph(bb))
    for _kid, g in state.get("kid_decode", []):
        for grp in g:
            decode.extend(grp)
    for cv in state.get("vev", []):
        decode.append(cv)
    objarr = b.new("NSArray")
    objarr.add("NSInlinedValue", *b.boolean(False))
    for x in decode:
        objarr.add("UINibEncoderEmptyKey",
                   *b.ref(x(b) if callable(x) else x))
    conn_arr = b.new("NSArray")
    conn_arr.add("NSInlinedValue", *b.boolean(False))
    conns = []
    known = {root_el.get("id"): view}
    id_map_all = state.get("id_map", {})
    for k, v in id_map_all.items():
        if v is not None:
            known[k] = v
    conns_el = vc_el.find("connections")
    for oc in (conns_el.findall("outlet") if conns_el is not None else ()):
        dst = known.get(oc.get("destination"))
        if dst is not None:
            if up is None:
                raise XibError(f"outlet {oc.get('property')!r} needs an upstream "
                               f"placeholder ({where})")
            conns.append((oc.get("property"), b.ref(up), b.ref(dst)))
    # outlets declared inside the view tree (e.g. collectionView delegate):
    # the owning element maps to UISource, the scene VC to the Upstream proxy
    owner = {root_el: view}
    for el in state.get("owners", []):
        owner[el[0]] = el[1]
    prototype_tags = {"collectionViewCell", "collectionReusableView"}

    def in_prototype(n):
        return n.tag in prototype_tags if isinstance(n.tag, str) else False
    for node in root_el.iter():
        if isinstance(node.tag, str) and node.tag in prototype_tags:
            continue  # cell prototypes compile into their own archives
        rc = node.find("connections") if isinstance(node.tag, str) else None
        if rc is None:
            continue
        for oc in rc.findall("outlet"):
            if oc.get("destination") == vc_id:
                if up is None or node not in owner:
                    raise XibError(f"outlet {oc.get('property')!r} unroutable ({where})")
                conns.append((_attr(oc, "property", where), b.ref(owner[node]),
                              b.ref(up)))
            else:
                raise XibError(f"unroutable outlet {oc.attrib} ({where})")
    for prop, src, dst in sorted(conns, key=lambda t: t[0]):
        c = b.new("UIRuntimeOutletConnection")
        c.add("UILabel", *b.ref(b.string(prop)))
        c.add("UISource", *src)
        c.add("UIDestination", *dst)
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    c = b.new("UIRuntimeOutletConnection")
    c.add("UILabel", *b.ref(b.string("view")))
    c.add("UISource", *b.ref(fo))
    c.add("UIDestination", *b.ref(view))
    conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    for sel, mask, src_obj, dst_id in sorted(events, key=lambda e: e[0]):
        if dst_id != vc_id or up is None:
            raise XibError(f"action {sel!r} unroutable in scene view ({where})")
        c = b.new("UIRuntimeEventConnection")
        c.add("UILabel", *b.ref(b.string(sel)))
        c.add("UISource", *b.ref(src_obj))
        c.add("UIDestination", *b.ref(up))
        c.add("UIEventMask", *b.int_fit(mask))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    empty = sb.empty_array()
    root.add("UINibTopLevelObjectsKey", *b.ref(top))
    root.add("UINibObjectsKey", *b.ref(objarr))
    root.add("UINibConnectionsKey", *b.ref(conn_arr))
    for key in ("UINibVisibleWindowsKey", "UINibAccessibilityConfigurationsKey",
                "UINibTraitStorageListsKey"):
        root.add(key, *b.ref(empty))
    # flow-layout runtime attributes (estimatedItemSize)
    for marker_el, target in sb.pairs:
        if marker_el == "__flow__":
            pass
    flow_pairs = [(el, t) for el, t in sb.pairs if el == "__flow__"]
    if flow_pairs:
        kvp = b.new("NSArray")
        kvp.add("NSInlinedValue", *b.boolean(False))
        for _el, target in flow_pairs:
            p = b.new("UINibKeyValuePair")
            v = _estimated_item_size_value(b)
            p.add("UIObject", *b.ref(target))
            p.add("UIValue", *b.ref(v))
            p.add("UIKeyPath", *b.ref(b.string("estimatedItemSize")))
            kvp.add("UINibEncoderEmptyKey", *b.ref(p))
        root.add("UINibKeyValuePairsKey", *b.ref(kvp))
    else:
        root.add("UINibKeyValuePairsKey", *b.ref(empty))
    root.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root)


def _proxy(b, ident):
    p = b.new("UIProxyObject")
    p.add("UIProxiedObjectIdentifier", *b.ref(b.string(ident)))
    return p


def _swift_class(el):
    """The runtime class name for a customClass, mangled with its module like Apple's ibtool."""
    cls = el.get("customClass")
    if not cls:
        return None
    module = TARGET_MODULE if el.get("customModuleProvider") == "target" and TARGET_MODULE else el.get("customModule")
    return f"_TtC{len(module)}{module}{len(cls)}{cls}" if module else cls


NAV_ATTRS = {"automaticallyAdjustsScrollViewInsets", "id", "sceneMemberID"}
NAV_BAR_ATTRS = {"key", "contentMode", "id"}


def _scene_nav_nib(nav, root, root_view_nib, where):
    """A UINavigationController scene with its rootViewController, object for object as Apple's
    ibtool 27.0 writes Mastodon's MainInterface.storyboard (tests/ibtool/golden)."""
    if set(nav.attrib) - NAV_ATTRS or nav.get("automaticallyAdjustsScrollViewInsets") != "NO":
        raise XibError(f"<navigationController> attributes {dict(nav.attrib)} not supported ({where})")
    bar_el = nav.find("navigationBar[@key='navigationBar']")
    if bar_el is None or set(bar_el.attrib) - NAV_BAR_ATTRS or bar_el.get("contentMode") != "scaleToFill":
        raise XibError(f"<navigationController> needs a plain navigationBar ({where})")
    mask = bar_el.find("autoresizingMask[@key='autoresizingMask']")
    rect = bar_el.find("rect[@key='frame']")
    if mask is None or set(mask.attrib) != {"key"} or rect is None:
        raise XibError(f"<navigationBar> frame/autoresizingMask not supported ({where})")
    extra = {c.tag for c in nav} - {"toolbarItems", "navigationBar", "nil", "connections"}
    item_el = root.find("navigationItem[@key='navigationItem']")
    if extra or nav.find("toolbarItems/*") is not None or item_el is None or len(item_el) or \
            set(item_el.attrib) != {"key", "id"}:
        raise XibError(f"<navigationController>/root navigationItem shape not supported ({where})")
    nav_name = f"UINavigationController-{nav.get('id')}"
    b = Builder()
    root_obj = b.new("NSObject")
    top = b.new("NSArray")
    sb_child = _proxy(b, "UIStoryboardPlaceholder")
    fo = _proxy(b, "IBFilesOwner")
    fr = _proxy(b, "IBFirstResponder")
    sb_nav = b.new("UIProxyObject")
    sb_nav.add("UIProxiedObjectIdentifier", *b.ref(b.string("UIStoryboardPlaceholder")))
    nav_sw = b.new("UIClassSwapper")
    children = b.new("NSMutableArray")
    vc_sw = b.new("UIClassSwapper")
    item = b.new("UINavigationItem")
    empty = b.new("NSArray")
    ext = b.new("NSDictionary")
    nib_name = b.string(root_view_nib)
    cls_name = b.string(_swift_class(root) or "UIViewController")
    orig_name = b.string("UIViewController")
    vcs = b.new("NSMutableArray")
    bar = b.new("UINavigationBar")
    hugging = b.string("{250, 250}")
    items = b.new("NSMutableArray")
    nav_cls = b.string("UINavigationController")
    objarr = b.new("NSArray")
    conn_arr = b.new("NSArray")
    c1 = b.new("UIRuntimeOutletConnection")
    storyboard = b.string("storyboard")
    c2 = b.new("UIRuntimeOutletConnection")
    c3 = b.new("UIRuntimeOutletConnection")
    scene_vc = b.string("sceneViewController")

    def fill(arr, refs):
        arr.add("NSInlinedValue", *b.boolean(False))
        for r in refs:
            arr.add("UINibEncoderEmptyKey", *b.ref(r))

    nav_sw.add("UIChildViewControllers", *b.ref(children))
    nav_sw.add("UIKeyAutomaticallyAdjustsScrollViewInsets", *b.int8(0))
    nav_sw.add("UIViewControllers", *b.ref(vcs))
    nav_sw.add("UINavigationBar", *b.ref(bar))
    nav_sw.add("UIClassName", *b.ref(nav_cls))
    nav_sw.add("UIOriginalClassName", *b.ref(nav_cls))
    fill(children, [vc_sw])
    vc_sw.add("UINavigationItem", *b.ref(item))
    vc_sw.add("UIExternalObjectsTableForViewLoading", *b.ref(ext))
    vc_sw.add("UINibName", *b.ref(nib_name))
    vc_sw.add("UIParentViewController", *b.ref(nav_sw))
    vc_sw.add("UIClassName", *b.ref(cls_name))
    vc_sw.add("UIOriginalClassName", *b.ref(orig_name))
    item.add("UICenterItemGroups", *b.ref(empty))
    item.add("UILargeTitleDisplayMode", *b.int8(0))
    item.add("UINavigationBar", *b.ref(bar))
    fill(empty, [])
    ext.add("NSInlinedValue", *b.boolean(False))
    fill(vcs, [vc_sw])
    # Apple ignores the XML width/height: zero width, 54 pt tall, at the frame's y.
    y = float(_attr(rect, "y", where))
    bar.add("UIBounds", *b.geom(0, 0, 0, 54))
    bar.add("UICenter", *b.geom(0, y + 27))
    bar.add("UIDeepDrawRect", *b.boolean(False))
    bar.add("UIAutoresizeSubviews", *b.boolean(False))
    bar.add("UIAutoresizingMask", *b.int8(2))
    bar.add("UIViewContentHuggingPriority", *b.ref(hugging))
    bar.add("UIViewLayoutMargins", *b.geom(0, 0, 0, 0))
    bar.add("UIViewLayoutMarginsAreDirectional", *b.boolean(False))
    bar.add("UIViewSemanticContentAttribute", *b.int8(0))
    bar.add("UIViewLargeContentStoredProperties", N.NIL, None)
    bar.add("UIIsLocked", *b.boolean(False))
    bar.add("UIItems", *b.ref(items))
    bar.add("UIDelegate", *b.ref(nav_sw))
    bar.add("UIBarPosition", *b.int8(2))
    bar.add("UIBarTranslucence", *b.int8(1))
    fill(items, [item])
    fill(top, [sb_child, fo, fr, sb_nav, nav_sw])
    fill(objarr, [sb_child, fo, fr, sb_nav, nav_sw, bar, vc_sw, item])
    fill(conn_arr, [c1, c2, c3])
    for c, label, src, dst in ((c1, storyboard, nav_sw, sb_nav), (c2, storyboard, vc_sw, sb_child),
                               (c3, scene_vc, fo, nav_sw)):
        c.add("UILabel", *b.ref(label))
        c.add("UISource", *b.ref(src))
        c.add("UIDestination", *b.ref(dst))
    root_obj.add("UINibTopLevelObjectsKey", *b.ref(top))
    root_obj.add("UINibObjectsKey", *b.ref(objarr))
    root_obj.add("UINibConnectionsKey", *b.ref(conn_arr))
    for key in ("UINibVisibleWindowsKey", "UINibAccessibilityConfigurationsKey",
                "UINibTraitStorageListsKey", "UINibKeyValuePairsKey"):
        root_obj.add(key, *b.ref(empty))
    root_obj.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root_obj), nav_name




def build_switch(b, el, where, id_map, named=None):
    _check_shape(el, where, shape="switch")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UISwitch")
    if el.get("id"):
        id_map[el.get("id")] = o
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(36))
    o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
          *b.boolean(el.get("translatesAutoresizingMaskIntoConstraints", "YES") != "NO"))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    o.add("UISwitchEnabled", *b.boolean(False))
    if el.get("on") == "YES":
        o.add("UISwitchOn", *b.boolean(False))
    tint = el.find("color[@key='onTintColor']")
    if tint is not None:
        if tint.get("name") is None:
            raise XibError(f"<switch> onTintColor must be a named color ({where})")
        o.add("UISwitchOnTintColor", *b.ref(build_named_color(b, tint.get("name"), named, where)))
    # UISwitch frames are also applied through a key-value pair (oracle).
    x, y, w, h = _frame(el)
    rect = "{{%s, %s}, {%s, %s}}" % tuple(_ibnum(v) for v in (x, y, w, h))
    b.kv_pair(o, lambda: b.nsvalue_rect(rect), "frame")
    events = []
    for ac in el.findall("connections/action"):
        if ac.get("eventType") != "valueChanged":
            raise XibError(f"<switch> action eventType {ac.get('eventType')!r} not supported ({where})")
        events.append((ac.get("selector"), ac.get("destination"), ac.get("eventType"), o))
    return o, events


def build_slider(b, el, where, id_map, named=None):
    _check_shape(el, where, shape="slider")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    cls = _swift_class(el)
    o = b.new("UIClassSwapper" if cls else "UISlider")
    if el.get("id"):
        id_map[el.get("id")] = o
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(36))
    o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
          *b.boolean(el.get("translatesAutoresizingMaskIntoConstraints", "YES") != "NO"))
    o.add("UIViewContentHuggingPriority", *b.ref(b.string("{250, 250}")))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    for key, attr in (("UIValue", "value"), ("UIMinValue", "minValue"), ("UIMaxValue", "maxValue")):
        if el.get(attr) is not None:
            o.add(key, *b.float32(float(el.get(attr))))
    thumb = el.find("color[@key='thumbTintColor']")
    if thumb is not None:
        if thumb.get("name") is None:
            raise XibError(f"<slider> thumbTintColor must be a named color ({where})")
        o.add("UIThumbTintColor", *b.ref(build_named_color(b, thumb.get("name"), named, where)))
    o.add("UIBehavioralStyle", *b.int8(0))
    if cls:
        o.add("UIClassName", *b.ref(b.string(cls)))
        o.add("UIOriginalClassName", *b.ref(b.string("UISlider")))
    return o


def _ibnum(v):
    """Apple's IB float formatting inside rect strings (293, 12, 51.5...)."""
    v = float(v)
    return str(int(v)) if v == int(v) else str(v)


TABLE_ATTRS = {"key", "clipsSubviews", "contentMode", "alwaysBounceVertical",
               "dataMode", "style", "separatorStyle", "rowHeight",
               "estimatedRowHeight", "sectionHeaderHeight", "sectionFooterHeight",
               "id"}


def _scroll_common(b, o, el, where, delegate_first=False):
    o.add("UIScrollViewIndicatorInsetAdjustmentBehavior", *b.int8(1))
    o.add("UIBouncesZoom", *b.boolean(False))
    if delegate_first:
        o.add("UIDelegate", N.NIL, None)
    if el.get("alwaysBounceVertical") is not None:
        if el.get("alwaysBounceVertical") != "YES":
            raise XibError(f"<{el.tag}> alwaysBounceVertical={el.get('alwaysBounceVertical')!r} not supported ({where})")
        o.add("UIAlwaysBounceVertical", *b.boolean(False))
    o.add("UIScrollViewContentInsetAdjustmentBehavior", *b.int8(0))


DEVICE_SIZES = {"retina4": (320, 568), "retina4_0": (320, 480), "retina4_7": (375, 667),
                "retina5_5": (414, 736), "retina5_9": (320, 568), "retina6_1": (414, 896), "retina6_3": (393, 852),
                "retina6_5": (414, 896)}


def _scroll_view_base(b, o, el, where, resources, device=None):
    if device is not None and device in DEVICE_SIZES:
        # A root table/collection view compiles at the full device size even
        # when simulated bars shrink the canvas rect (oracle scenes 4/5).
        bw, bh = DEVICE_SIZES[device]
        bx = by = 0.0
        cx, cy = bw / 2, bh / 2
    else:
        (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    color = el.find("color[@key='backgroundColor']")
    if color is not None:
        if color.get("systemColor") is None:
            raise XibError(f"<{el.tag}> backgroundColor must be a systemColor ({where})")
        o.add("UIBackgroundColor", *b.ref(build_color(b, color.get("systemColor"), where, resources)))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIOpaque", *b.boolean(False))
    if el.get("multipleTouchEnabled") is not None:
        o.add("UIMultipleTouchEnabled", *b.boolean(el.get("multipleTouchEnabled") != "YES"))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    mask_el = el.find("autoresizingMask[@key='autoresizingMask']")
    mask = 0
    if mask_el is not None:
        if mask_el.get("widthSizable") == "YES":
            mask |= 2
        if mask_el.get("heightSizable") == "YES":
            mask |= 16
        if set(mask_el.attrib) - {"key", "widthSizable", "heightSizable"}:
            raise XibError(f"<{el.tag}> autoresizingMask has unsupported flags ({where})")
    if mask != 18:
        raise XibError(f"<{el.tag}> expects a width+height autoresizing mask ({where})")
    o.add("UIAutoresizingMask", *b.int8(mask))
    if el.get("clipsSubviews") is not None:
        o.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)


class _ViewData:
    pass


NAV_BAR_CENTER_Y = None  # set by compile_storyboard when the scene sits in a nav


def build_table_view(b, tv_el, where, resources, vc_id, named=None, id_map=None, device=None):
    """<tableView key="view">, static or prototypes. Returns the UITableView plus
    everything the scene nib needs (sections, decode order, raw connections)."""
    unknown = set(tv_el.attrib) - TABLE_ATTRS
    if unknown:
        raise XibError(f"<tableView> has unsupported attribute(s) {sorted(unknown)} ({where})")
    mode = _attr(tv_el, "dataMode", where)
    if tv_el.get("style", "plain") != "insetGrouped":
        raise XibError(f"<tableView> style={tv_el.get('style')!r} not supported ({where})")
    if tv_el.get("separatorStyle", "default") != "default":
        raise XibError(f"<tableView> separatorStyle={tv_el.get('separatorStyle')!r} not supported ({where})")
    for extra in tv_el:
        if extra.tag not in ("rect", "autoresizingMask", "color", "sections",
                             "prototypes", "connections", "view"):
            raise XibError(f"<tableView> has unsupported <{extra.tag}> ({where})")
    d = _ViewData()
    d.id_map = id_map
    o = b.new("UITableView")
    _scroll_view_base(b, o, tv_el, where, resources, device)
    if tv_el.find("view[@key='tableFooterView']") is None and tv_el.find("color[@key='backgroundColor']") is None:
        color = build_color(b, "systemGroupedBackgroundColor", where, resources)
        o.values.insert(2, ("UIBackgroundColor", N.Value(0, N.OBJREF, color.idx)))
    _scroll_common(b, o, tv_el, where)
    o.add("UITableViewStyle", *b.int8(2))
    o.add("UIStyle", *b.int8(1))
    o.add("UISeparatorStyle", *b.int8(1))
    o.add("UISeparatorStyleIOS5AndLater", *b.int8(1))
    o.add("UIPrefetchingEnabled", *b.boolean(False))
    o.add("UIRowHeight", *b.float32(float(tv_el.get("rowHeight", "-1"))))
    o.add("UISectionHeaderHeight", *b.float32(float(tv_el.get("sectionHeaderHeight", "-1"))))
    o.add("UISectionFooterHeight", *b.float32(float(tv_el.get("sectionFooterHeight", "-1"))))
    o.add("UIEstimatedRowHeight", *b.float32(float(tv_el.get("estimatedRowHeight", "-1"))))
    o.add("UIEstimatedSectionHeaderHeight", *b.float32(0.0))
    o.add("UIEstimatedSectionFooterHeight", *b.float32(0.0))
    o.add("UIFillerRowHeight", *b.float64(0.0))
    o.add("UISectionHeaderTopPadding", *b.float64(-1.0))
    o.add("UIInsetsContentViewsToSafeArea", *b.boolean(False))

    d.tv_conns = [(c.get("property"), c.get("destination"))
                  for c in tv_el.findall("connections/outlet")]
    for prop, _dst in d.tv_conns:
        if prop not in ("dataSource", "delegate"):
            raise XibError(f"<tableView> outlet {prop!r} not supported ({where})")
    d.outlets = []   # (label, src_obj, dst_obj, section_idx, row_key)
    d.events = []    # (selector, dst_obj, mask)
    d.sections = []
    d.swappers = []
    d.decoded = []   # (cv, kids) per cell
    d.cons = []
    d.footer = None
    d.footer_tail = []
    d.cell_uda_entries = []  # deferred (el, target) cell-element UDA entries
    d.subview_uda_entries = []  # deferred (el, target) subview UDA entries
    d.kv_marks = []          # per-cell [start, end) slices into b.kv_pairs
    footer_el = tv_el.find("view[@key='tableFooterView']")
    if footer_el is not None:
        # creation order (app gold): the footer subtree encodes right after the
        # tableView's UISubviews array, BEFORE the data source and sections
        subs_arr = b.new("NSMutableArray")
        subs_arr.add("NSInlinedValue", *b.boolean(False))
        fobj, fdecode, fevents, _fpairs = build_view(b, footer_el, where, resources, named, top=False, id_map=id_map)
        id_map[footer_el.get("id")] = fobj
        if NAV_BAR_CENTER_Y is not None:
            # Apple re-anchors the static-table footer under the navigation bar
            # (app gold 1m3: center = (w/2, nav-bar center))
            fx, fy, fw, fh = _frame(footer_el)
            fobj.values[1] = ("UICenter", N.Value(0, N.DATA,
                               b"\x07" + struct.pack("<2d", fw / 2, NAV_BAR_CENTER_Y)))
        subs_arr.add("UINibEncoderEmptyKey", *b.ref(fobj))
        d.footer = fobj
        # scene-rule tail: own constraints first, then the subview subtree
        d.footer_tail = [x for x in fdecode[1:] if getattr(x, "cls", None) == "NSLayoutConstraint"] \
            + [x for x in fdecode[1:] if getattr(x, "cls", None) != "NSLayoutConstraint"]
        o.values.insert(2, ("UISubviews", N.Value(0, N.OBJREF, subs_arr.idx)))
        o.values.insert(3, ("UIBackgroundColor",
                            N.Value(0, N.OBJREF,
                                    build_color(b, "systemGroupedBackgroundColor", where, resources).idx)))
        o.add("UITableFooterView", *b.ref(fobj))
        for sel, dst_id, ev, src in fevents:
            if ev not in EVENT_MASKS:
                raise XibError(f"footer action eventType {ev!r} not supported ({where})")
            d.events.append((sel, src, dst_id, EVENT_MASKS[ev]))
    if mode == "static":
        ds = b.new("UITableViewDataSource")
        sections_arr = b.new("NSArray")
        sections_arr.add("NSInlinedValue", *b.boolean(False))
        ds.add("UITableSections", *b.ref(sections_arr))
        for si, sec_el in enumerate(tv_el.findall("sections/tableViewSection")):
            sec = b.new("UITableViewSection")
            d.sections.append(sec)
            header = sec_el.get("headerTitle")
            if header is not None:
                if set(sec_el.attrib) - {"headerTitle", "id"}:
                    raise XibError(f"<tableViewSection> unsupported attributes ({where})")
                sec.add("UITableSectionHeaderTitle",
                        *b.ref(_localizable(b, header, f"{sec_el.get('id')}.headerTitle")))
            elif set(sec_el.attrib) - {"id"}:
                raise XibError(f"<tableViewSection> unsupported attributes ({where})")
            rows_arr = b.new("NSArray")
            rows_arr.add("NSInlinedValue", *b.boolean(False))
            sec.add("UITableSectionRows", *b.ref(rows_arr))
            cells = sec_el.findall("cells/tableViewCell")
            for ri, cell_el in enumerate(cells):
                row = b.new("UITableViewRow")
                mark0 = len(b.kv_pairs)
                sw, _dec, cell_outlets, cell_events, pairs_, cv, kids = build_cell(b, cell_el, where, resources, named, id_map)
                mark1 = len(b.kv_pairs)
                d.kv_marks.append((mark0, mark1))
                # first deferred entry is the cell element's own UDA set
                d.cell_uda_entries.extend(e for e in pairs_ if e[1] is sw)
                d.subview_uda_entries.extend(e for e in pairs_ if e[1] is not sw)
                skip = {sw, cv, *kids}
                for prop, dst in cell_outlets:
                    # row_key reversed: within a section Apple lists the last
                    # row's connections first (oracle probes p1/p2/p3).
                    d.outlets.append((prop, sw, dst, si, len(cells) - 1 - ri))
                for sel, src, dst, ev in cell_events:
                    if ev not in EVENT_MASKS:
                        raise XibError("action eventType " + repr(ev) + " not supported at cell " + repr(cell_el.get("id")) + " (" + where + ")")
                    d.events.append((sel, src, dst, EVENT_MASKS[ev]))
                row.add("UITableRowCell", *b.ref(sw))
                row.add("UITableRowHeight", *b.float32(-1.0))
                rows_arr.add("UINibEncoderEmptyKey", *b.ref(row))
                d.swappers.append(sw)
                d.decoded.append((cv, kids))
                # full cell tail keeps Apple's decode order (cv cons, per-kid
                # groups, deferred stack kids)
                d.cons.extend(x for x in _dec if x not in skip)

            sections_arr.add("UINibEncoderEmptyKey", *b.ref(sec))
        d.ds = ds
    elif mode == "prototypes":
        if tv_el.findall("sections/tableViewSection"):
            raise XibError(f"<tableView> prototypes with sections not supported ({where})")
        nibs = b.new("NSMutableDictionary")
        nibs.add("NSInlinedValue", *b.boolean(False))
        pairs = []
        for cell_el in tv_el.findall("prototypes/tableViewCell"):
            reuse = _attr(cell_el, "reuseIdentifier", where)
            pairs.append((reuse, _embedded_table_cell(cell_el, where, resources, named)))
        for reuse, arch in pairs:
            s = b.string(reuse)
            nib = b.new("UINib")
            nib.add("captureEnclosingNIBBundleOnDecode", *b.boolean(False))
            data = b.new("NSData")
            data.add("NS.bytes", N.DATA, arch)
            nib.add("archiveData", *b.ref(data))
            nibs.add("UINibEncoderEmptyKey", *b.ref(s))
            nibs.add("UINibEncoderEmptyKey", *b.ref(nib))
        ext = b.new("NSMutableDictionary")
        ext.add("NSInlinedValue", *b.boolean(False))
        for reuse, _arch in pairs:
            s = b.string(reuse)
            md = b.new("NSMutableDictionary")
            md.add("NSInlinedValue", *b.boolean(False))
            ext.add("UINibEncoderEmptyKey", *b.ref(s))
            ext.add("UINibEncoderEmptyKey", *b.ref(md))
        o.add("UITableViewCellPrototypeNibs", *b.ref(nibs))
        o.add("UITableViewCellPrototypeNibExternalObjects", *b.ref(ext))
        d.ds = None
    else:
        raise XibError(f"<tableView> dataMode={mode!r} not supported ({where})")
    o.add("UISeparatorInsetReference", *b.int8(0))
    d.tv = o
    d.mode = mode
    return d


def _embedded_table_cell(cell_el, where, resources, named):
    """A prototype <tableViewCell> compiles to a standalone NIBArchive that the
    storyboard embeds as a UINib (oracle fO4-og-e41-view-I8p-P9-C8h.nib)."""
    b = Builder()
    b.resources = resources
    root = b.new("NSObject")
    top_array = b.new("NSArray")
    fo = _proxy(b, "IBFilesOwner")
    fr = _proxy(b, "IBFirstResponder")
    sw, _dec, outlets, cell_events, pairs_, cv, kids = build_cell(b, cell_el, where, resources, named)

    def fill(arr, items):
        arr.add("NSInlinedValue", *b.boolean(False))
        for item in items:
            arr.add("UINibEncoderEmptyKey", *b.ref(item))

    fill(top_array, [fo, fr, sw])
    objarr = b.new("NSArray")
    fill(objarr, [fo, fr, sw, cv] + [k for k in kids])
    for c in _dec:
        if getattr(c, "cls", None) == "NSLayoutConstraint":
            objarr.add("UINibEncoderEmptyKey", *b.ref(c))
    conn_arr = b.new("NSArray")
    conn_arr.add("NSInlinedValue", *b.boolean(False))
    for prop, dst in outlets:
        c = b.new("UIRuntimeOutletConnection")
        c.add("UILabel", *b.ref(b.string(prop)))
        c.add("UISource", *b.ref(sw))
        c.add("UIDestination", *b.ref(dst))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    for sel, src, dst, ev in cell_events:
        if ev not in EVENT_MASKS:
            raise XibError(f"action eventType {ev!r} not supported ({where})")
        c = b.new("UIRuntimeEventConnection")
        c.add("UILabel", *b.ref(b.string(sel)))
        c.add("UISource", *b.ref(src))
        c.add("UIDestination", *b.ref(sw))
        c.add("UIEventMask", *b.int_fit(EVENT_MASKS[ev]))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))
    empty = conn_arr if not outlets else b.new("NSArray")
    if empty is not conn_arr:
        empty.add("NSInlinedValue", *b.boolean(False))
    root.add("UINibTopLevelObjectsKey", *b.ref(top_array))
    root.add("UINibObjectsKey", *b.ref(objarr))
    root.add("UINibConnectionsKey", *b.ref(conn_arr))
    for key in ("UINibVisibleWindowsKey", "UINibAccessibilityConfigurationsKey",
                "UINibTraitStorageListsKey", "UINibKeyValuePairsKey"):
        root.add(key, *b.ref(empty))
    root.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root)


def _scene_table_view_nib(vc_el, view_el, where, resources, named, device=None):
    """A table view controller scene's view nib: the table view with its data
    (static sections or embedded prototype nibs) and all connections."""
    b = Builder()
    root = b.new("NSObject")
    top_array = b.new("NSArray")
    fo = _proxy(b, "IBFilesOwner")
    fr = _proxy(b, "IBFirstResponder")
    up = _proxy(b, "UpstreamPlaceholder-1")
    id_map = {}
    d = build_table_view(b, view_el, where, resources, vc_el.get("id"), named, id_map, device)
    d.id_map = id_map
    top_array.add("NSInlinedValue", *b.boolean(False))
    tops = [fo, fr, up, d.tv] + ([d.ds] if d.ds is not None else [])
    for item in tops:
        top_array.add("UINibEncoderEmptyKey", *b.ref(item))
    objarr = b.new("NSArray")
    objarr.add("NSInlinedValue", *b.boolean(False))
    decode = [fo, fr, up, d.tv] + ([d.ds] if d.ds is not None else [])
    if d.mode == "static":
        # golden Inspector account nib: tableView, dataSource, footer, sections,
        # footer tail (cons + button), cell swappers, per-cell subtrees, tails
        decode += ([d.footer] if d.footer is not None else []) + d.sections
        decode += d.footer_tail
        decode += d.swappers
        for cv, kids in d.decoded:
            decode += [cv] + list(kids)
        decode += d.cons
    for item in decode:
        objarr.add("UINibEncoderEmptyKey", *b.ref(item))
    # Connections: the synthesized staticDataSource first, then outlets sorted
    # alphabetically (ties: sections forward, rows reversed), then actions.
    conns = []  # (label, src, dst, is_event, provenance or None)
    if d.ds is not None:
        conns.append(("staticDataSource", fo, d.ds, False, None))
    for prop, _dst_id in d.tv_conns:
        conns.append((prop, d.tv, up, False, None))
    for oc in vc_el.findall("connections/outlet"):
        prop, dst_id = oc.get("property"), oc.get("destination")
        dst = d.id_map.get(dst_id)
        if dst is None:
            raise XibError(f"{where}: outlet {prop!r} destination {dst_id!r} is not in this scene's view")
        conns.append((prop, up, dst, False, None))
    for prop, src, dst, si, rk in d.outlets:
        conns.append((prop, src, dst, False, (si, rk)))
    if not any(c[0] == "view" for c in conns):
        conns.append(("view", fo, d.tv, False, None))

    def conn_key(c):
        label, _src, _dst, _ev, prov = c
        if prov is None:
            return (label, -1, 0)
        return (label, prov[0], prov[1])

    # app flavor: staticDataSource hoisted first, XML outlets alphabetical, view last
    head = [c for c in conns if c[0] == "staticDataSource"]
    tail = [c for c in conns if c[0] == "view"]
    mid = sorted([c for c in conns if c[0] not in ("staticDataSource", "view")
                  and not c[3]], key=conn_key)
    outlets_only = head + mid + tail
    conn_arr = b.new("NSArray")
    conn_arr.add("NSInlinedValue", *b.boolean(False))

    def emit(label, src, dst, is_event, mask=None):
        c = b.new("UIRuntimeEventConnection" if is_event else "UIRuntimeOutletConnection")
        c.add("UILabel", *b.ref(b.string(label)))
        c.add("UISource", *b.ref(src))
        c.add("UIDestination", *b.ref(dst))
        if is_event:
            c.add("UIEventMask", *b.int_fit(mask))
        conn_arr.add("UINibEncoderEmptyKey", *b.ref(c))

    for label, src, dst, _ev, _p in outlets_only:
        emit(label, src, dst, False)
    for sel, src, dst_id, mask in sorted(d.events, key=lambda e: e[0]):
        # action destinations outside this scene's view (the VC) decode as the
        # UpstreamPlaceholder proxy
        dst_obj = d.id_map.get(dst_id) if isinstance(dst_id, str) else dst_id
        emit(sel, src, dst_obj if dst_obj is not None else up, True, mask)
    empty = b.new("NSArray")
    empty.add("NSInlinedValue", *b.boolean(False))
    kv_arr = None
    if b.kv_pairs or getattr(d, "cell_uda_entries", None) or getattr(d, "subview_uda_entries", None):
        kv_arr = b.new("NSArray")
        kv_arr.add("NSInlinedValue", *b.boolean(False))
        # app flavor: all pairs (synthesized frames + UDAs) sort by the target's
        # Cell-level UDAs precede the generated cell-frame pairs in table nibs.
        cell_uda_pairs = [kv for el, tgt in getattr(d, "cell_uda_entries", [])
                          for kv in _uda_build(b, el, tgt, resources, named)]
        for el, tgt in getattr(d, "subview_uda_entries", []):
            b.kv_pairs.append((tgt, (lambda e=el, t=tgt: _uda_build(b, e, t, resources, named)), None))
        pairs = cell_uda_pairs + b.kv_pair_flush()
        for kv in pairs:
            kv_arr.add("UINibEncoderEmptyKey", *b.ref(kv))
    root.add("UINibTopLevelObjectsKey", *b.ref(top_array))
    root.add("UINibObjectsKey", *b.ref(objarr))
    root.add("UINibConnectionsKey", *b.ref(conn_arr))
    for key in ("UINibVisibleWindowsKey", "UINibAccessibilityConfigurationsKey",
                "UINibTraitStorageListsKey"):
        root.add(key, *b.ref(empty))
    root.add("UINibKeyValuePairsKey", *b.ref(kv_arr if kv_arr is not None else empty))
    root.add("IBUINibLNEVersionKey", *b.int8(1))
    return finalize(b, root)


NAV_IDENT_ATTRS = {"storyboardIdentifier", "id", "sceneMemberID"}
NAV_IDENT_BAR_ATTRS = {"key", "contentMode", "id", "insetsLayoutMarginsFromSafeArea"}


VC_ORIGINAL_CLASS = {"viewController": "UIViewController",
                     "tableViewController": "UITableViewController",
                     "collectionViewController": "UICollectionViewController"}


def _scene_nav_nib_ident(nav, root_vc, root_view_nib, where):
    """A storyboardIdentifier-carrying navigation controller scene
    (oracle SettingsNavigationViewController.nib)."""
    if set(nav.attrib) - NAV_IDENT_ATTRS:
        raise XibError(f"<navigationController> attributes {dict(nav.attrib)} not supported ({where})")
    bar_el = nav.find("navigationBar[@key='navigationBar']")
    if bar_el is None or set(bar_el.attrib) - NAV_IDENT_BAR_ATTRS or \
            bar_el.get("contentMode") != "scaleToFill":
        raise XibError(f"<navigationController> needs a plain navigationBar ({where})")
    rect = bar_el.find("rect[@key='frame']")
    if rect is None or bar_el.find("autoresizingMask[@key='autoresizingMask']") is None or \
            set(bar_el.find("autoresizingMask[@key='autoresizingMask']").attrib) != {"key"}:
        raise XibError(f"<navigationBar> frame/autoresizingMask not supported ({where})")
    extra = {c.tag for c in nav} - {"navigationBar", "connections"}
    if extra or nav.find("connections/segue") is None:
        raise XibError(f"<navigationController> shape not supported ({where})")
    sb = _Scene()
    b = sb.b
    root_obj = b.new("NSObject")
    top = b.new("NSArray")
    sb_child = _proxy(b, "UIStoryboardPlaceholder")
    fo = _proxy(b, "IBFilesOwner")
