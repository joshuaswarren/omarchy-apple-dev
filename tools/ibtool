    "imageView": {"frame", "constraints", "autoresizingMask", "tintColor",
                  "userDefinedRuntimeAttributes"},
    "placeholder": set(),
    "tableViewCell": {"frame", "autoresizingMask", "contentView", "connections",
                      "canvasLocation", "userDefinedRuntimeAttributes"},
    "tableViewCellContentView": {"frame", "autoresizingMask", "subviews",
                                 "constraints"},
    "collectionView": {"frame", "autoresizingMask", "backgroundColor", "tintColor", "cells",
                       "sectionHeaderView", "collectionViewLayout", "connections",
                       "viewLayoutGuide"},
    "collectionViewFlowLayout": {"itemSize", "headerReferenceSize", "footerReferenceSize",
                                 "sectionInset"},
    "collectionViewCell": {"frame", "autoresizingMask", "contentView", "backgroundColor",
                           "connections", "customSize"},
    "collectionReusableView": {"frame", "autoresizingMask", "subviews", "constraints",
                               "connections", "viewLayoutGuide"},
    "collectionViewCellContentView": {"frame", "autoresizingMask", "subviews",
                                      "constraints", "viewLayoutGuide"},
    "tableView": {"frame", "autoresizingMask", "color", "sections", "prototypes",
