def _check_shape(el, where, shape=None):
    allowed = ALLOWED_ATTRS.get(shape or el.tag)
    if allowed is None:
        raise XibError(f"unsupported element <{el.tag}> ({where})")
    unknown = set(el.attrib) - allowed
    if unknown:
        raise XibError(f"<{el.tag}> has unsupported attribute(s) {sorted(unknown)} ({where})")
    subs = {child.tag if child.tag == "viewLayoutGuide"
            else (child.get("key") or child.tag) for child in el}
    extra = subs - ALLOWED_SUBS[shape or el.tag]
    if extra:
        raise XibError(f"<{el.tag}> has unsupported subelement(s) {sorted(extra)} ({where})")


def build_view(b, el, where, resources=None, named=None, top=True, id_map=None):
    """A plain <view>. Top-level (xib) views build their whole subtree here;
    returns (obj, decode_list, events, pairs). decode_list follows Apple's xib
    order: the view, its direct subviews, its constraint group, each direct
    subview's constraint group, then deferred stack-arranged subtrees."""
    _check_shape(el, where)
    mode = _attr(el, "contentMode", where)
    if mode != "scaleToFill":
        raise XibError(f"<view> contentMode={mode!r} not supported ({where})")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UIView")
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    cons_el = el.find("constraints")
    subs_el = el.find("subviews")
    bg_slot = None
    if subs_el is not None:
        subs = b.new("NSMutableArray")  # shell before the kids (golden order)
        subs.add("NSInlinedValue", *b.boolean(False))
        o.add("UISubviews", *b.ref(subs))
        bg_slot = len(o.values)
    o.add("UIDeepDrawRect", *b.boolean(False))
    if el.get("opaque") != "NO":  # Apple stores UIOpaque=false only for the default (opaque) view
        o.add("UIOpaque", *b.boolean(False))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(_autoresizing_mask(el, where, default=18 if top else 36)))
    id_map = {} if id_map is None else id_map
    if el.get("id"):
        id_map[el.get("id")] = o
    # A subview stores UIViewDoesNotTranslateAutoresizingMaskIntoConstraints
    # only when it participates in the constraint system (probe ins-button:
    # the constrained button stores it, the unconstrained ones do not).
    referenced = set()
    for c in (cons_el.findall("constraint") if cons_el is not None else ()):
        for end in ("firstItem", "secondItem"):
            if c.get(end):
                referenced.add(c.get(end))
    kids, groups, events, pairs = [], [], [], []
    deferred = []
    for child in (subs_el if subs_el is not None else ()):
        kid, kgroups, kevents, kpairs, kdeferred = _build_subview(
            b, child, where, resources, named, id_map, referenced)
        if child.get("id"):
            id_map[child.get("id")] = kid
        kids.append(kid)
        groups.extend(kgroups)
        events.extend(kevents)
        pairs.extend(kpairs)
        deferred.extend(kdeferred)
    if subs_el is not None:
        for k in kids:
            subs.add("UINibEncoderEmptyKey", *b.ref(k))
    # Apple keeps the background key right after UISubviews but creates the
    # color object after the subview subtree (golden ins-stack/ins-image).
    color = el.find("color[@key='backgroundColor']")
    if color is not None:
        if color.get("systemColor") is not None:
            cobj = build_color(b, color.get("systemColor"), where)
        elif color.get("name") is not None or color.get("white") is not None:
            cobj = build_color_el(b, color, where, resources, named)
        else:
            cobj = build_rgb_color(b, color, where)
        val = N.Value(0, N.OBJREF, cobj.idx)
        o.values.insert(bg_slot if bg_slot is not None else 2, ("UIBackgroundColor", val))
    if cons_el is not None:
        arr, cons = build_constraints_block(b, el, o, id_map, where)
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
        own = cons
    else:
        own = []
    decode = [o] + kids + own + [x for g in groups for x in g] \
        + [x for d in deferred for x in d]
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    pairs = _uda_pairs(b, el, o, resources, named) + pairs
    return o, decode, events, pairs


def _build_subview(b, el, where, resources, named, id_map, referenced):
    """One subview of a plain view or stack: dispatch on the element kind.
    Returns (obj, cons_groups, events, pairs, deferred_subtree)."""
    cid = el.get("id")
    in_cons = cid in referenced if cid else False
    kgroups, kevents, kpairs, kdeferred = [], [], [], []
    if el.tag == "label":
        kid, _lgroup = build_label(b, el, where)
    elif el.tag == "imageView":
        kid, kgroups = build_image_view(b, el, where, id_map, resources, named,
                                        in_constraints=in_cons)
    elif el.tag == "stackView":
        kid, kgroups, kevents, kpairs, kdeferred = build_stack_view(
            b, el, where, resources, named, id_map)
    elif el.tag == "textField":
        if el.find("constraints") is not None:
            raise XibError(f"<textField> with constraints not supported ({where})")
        kid = build_text_field(b, el, where, in_constraints=in_cons)
    elif el.tag == "button":
        kid, kgroups, kevents = build_button(b, el, where, resources, named,
                                             in_constraints=in_cons)
    elif el.tag == "view":
        kid, kdecode, kevents, kpairs = build_view(b, el, where, resources, named, top=False)
        # kdecode = [kid, grandkids..., kid cons..., ...]; its groups land after
        # this view's own group (the caller appends kgroups).
        ret = (kid, [kdecode[1:]], kevents, kpairs, [])
    else:
        raise XibError(f"unsupported subview <{el.tag}> ({where})")
    if cid:
        id_map[cid] = kid
    if "ret" in dir():
        return ret
    return kid, kgroups, kevents, \
        _uda_pairs(b, el, kid, resources, named) + kpairs, kdeferred


def build_label(b, el, where, resources=None, named=None):
    _check_shape(el, where)
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    cls = _swift_class(el)
    # Custom-class labels decode as UIClassSwapper (oracle: VibrantLabel).
    o = b.new("UIClassSwapper" if cls else "UILabel")
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIUserInteractionDisabled", *b.boolean(_attr(el, "userInteractionEnabled", where) != "NO"))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(36))  # IB's default for translates=NO
    cm = _attr(el, "contentMode", where)
    if cm not in CONTENT_MODES:
        raise XibError(f"<label> contentMode={cm!r} not supported ({where})")
    o.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
    # clipsSubviews, stored inverted as on the other views, after the content
    # mode (golden HelloWorld LaunchScreen).
    if el.get("clipsSubviews") is not None:
        o.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
    translates = el.get("translatesAutoresizingMaskIntoConstraints")
    if translates is None:
        raise XibError(f"<label> is missing translatesAutoresizingMaskIntoConstraints ({where})")
    o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
          *b.boolean(translates != "NO"))
    group = []
    if el.find("constraints") is not None:
        arr, cons = build_constraints_block(b, el, o, {el.get("id"): o}, where)
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
        group.append(cons)
    # hugging/compression default to 250 per axis (FeedCell fHH golden: only
    # verticalHuggingPriority on the element, stored as '{250, 251}')
    hug = f"{{{el.get('horizontalHuggingPriority', '250')}, {el.get('verticalHuggingPriority', '250')}}}"
    o.add("UIViewContentHuggingPriority", *b.ref(b.string(hug)))
    if el.get("horizontalCompressionResistancePriority") is not None:
        cr = f"{{{el.get('horizontalCompressionResistancePriority')}, {el.get('verticalCompressionResistancePriority', '750')}}}"
        o.add("UIViewContentCompressionResistancePriority", *b.ref(b.string(cr)))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    text = _attr(el, "text", where)
    lid = el.get("id")
    o.add("UIText", *b.ref(_localizable(b, text, f"{lid}.text" if lid else None)))
    adjusts = el.get("adjustsFontForContentSizeCategory")
    if adjusts is not None:
        o.add("UIAdjustsFontForContentSizeCategory", *b.boolean(False))
    o.add("UIFont", *b.ref(build_font(b, _sub(el, "fontDescription", where), where)))
    color_el = el.find("color[@key='textColor']")
    if color_el is None:
        o.add("UITextColor", *b.ref(build_color(b, "labelColor", where)))
    else:
        o.add("UITextColor", *b.ref(build_color_el(b, color_el, where, resources, named)))
    o.add("UIShadowOffset", *b.geom(0.0, -1.0))
    # adjustsFontSizeToFit: when the attribute is absent (and a minimumScale-
    # Factor is set) Apple writes the defaults UIAdjustsFontSizeToFit=false and
    # UIMinimumFontSize=8.5; when it is explicitly NO it writes nothing
    # (Main.storyboard goldens: oRt/TBA/LVW vs fHH/p16/eMj).
    fit = el.get("adjustsFontSizeToFit")
    if fit is None:
        o.add("UIAdjustsFontSizeToFit", *b.boolean(False))
        # An explicit minimumFontSize in place of the default 8.5 (golden
        # HelloWorld LaunchScreen).
        o.add("UIMinimumFontSize", *b.float32(float(el.get("minimumFontSize", "8.5"))))
    nol = el.get("numberOfLines")
    if nol is not None and nol != "1":
        o.add("UINumberOfLines", *b.int8(int(nol)))
    lbm = el.get("lineBreakMode")
    if lbm is not None and lbm != "tailTruncation":
        if lbm not in LINE_BREAK_MODES:
            raise XibError(f"<label> lineBreakMode={lbm!r} not supported ({where})")
        o.add("UILineBreakMode", *b.int8(LINE_BREAK_MODES[lbm]))
    ta = el.get("textAlignment", "left")  # absent -> left (FeedCell fHH golden)
    if ta not in TEXT_ALIGNMENTS:
        raise XibError(f"<label> textAlignment={ta!r} not supported ({where})")
    o.add("UITextAlignment", *b.int8(TEXT_ALIGNMENTS[ta]))
    msf = el.get("minimumScaleFactor")
    if msf is not None:
        o.add("UIMinimumScaleFactor", *b.float32(float(msf)))
    elif el.get("minimumFontSize") is not None:
        # The legacy minimumFontSize also gives a scale factor, minimumFontSize
        # over the point size as a float (golden HelloWorld LaunchScreen: 18/36
        # -> 0.5, 9/17 -> 0.5294118).
        ps = _sub(el, "fontDescription", where).get("pointSize")
        if ps is None:
            raise XibError(f"<label> minimumFontSize without a font pointSize ({where})")
        o.add("UIMinimumScaleFactor",
              *b.float32(float(el.get("minimumFontSize")) / float(ps)))
    if el.get("adjustsLetterSpacingToFitWidth") is not None:
        o.add("UIAdjustsLetterSpacingToFit", *b.boolean(False))
    pmw = el.get("preferredMaxLayoutWidth")
    if pmw is not None:
        o.add("UIPreferredMaxLayoutWidth", *b.float32(float(pmw)))
    nil_tc = el.find("nil[@key='textColor']") is not None
    o.add("UIDisableUpdateTextColorOnTraitCollectionChange", *b.boolean(nil_tc))
    if cls:
        o.add("UIClassName", *b.ref(b.string(cls)))
        o.add("UIOriginalClassName", *b.ref(b.string("UILabel")))
    return o, group


def _cell_label(b, el, where, resources, role):
    """<label> inside a tableViewCellContentView -> UITableViewLabel."""
    _check_shape(el, where, shape="cell-label")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UITableViewLabel")
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    if el.get("multipleTouchEnabled") is not None:
        o.add("UIMultipleTouchEnabled", *b.boolean(el.get("multipleTouchEnabled") != "YES"))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    cm = _attr(el, "contentMode", where)
    if cm not in CONTENT_MODES:
        raise XibError(f"<label> contentMode={cm!r} not supported ({where})")
    o.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
    if el.get("insetsLayoutMarginsFromSafeArea") is not None:
        o.add("UIViewInsetsLayoutMarginsFromSafeArea", *b.int8(0))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    text = _attr(el, "text", where)
    lid = el.get("id")
    o.add("UIText", *b.ref(_localizable(b, text, f"{lid}.text" if lid else None)))
    if el.get("adjustsFontForContentSizeCategory") is not None:
        o.add("UIAdjustsFontForContentSizeCategory", *b.boolean(False))
    o.add("UIFont", *b.ref(build_font(b, _sub(el, "fontDescription", where), where)))
    tc = el.find("color[@key='textColor']")
    if tc is not None and tc.get("systemColor") is not None:
        o.add("UITextColor", *b.ref(build_color(b, tc.get("systemColor"), where, resources)))
    else:
        o.add("UITextColor", *b.ref(build_color(b, "labelColor", where)))  # <nil/> or absent
    hc = el.find("color[@key='highlightedColor']")
    if hc is not None and hc.get("systemColor") is not None:
        o.add("UIHighlightedColor", *b.ref(build_color(b, hc.get("systemColor"), where, resources)))
    o.add("UIShadowOffset", *b.geom(0.0, -1.0))
    ta = _attr(el, "textAlignment", where)
    if ta not in TEXT_ALIGNMENTS:
        raise XibError(f"<label> textAlignment={ta!r} not supported ({where})")
    o.add("UITextAlignment", *b.int8(TEXT_ALIGNMENTS[ta]))
    # Golden: the cell's textLabel gets true, the detailTextLabel false.
    o.add("UIDisableUpdateTextColorOnTraitCollectionChange", *b.boolean(role == "text"))
    return o


def build_content_view(b, el, where, resources, roles, id_map, named=None):
    _check_shape(el, where)
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UITableViewCellContentView")
    if el.get("id"):
        id_map[el.get("id")] = o
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    subs = b.new("NSMutableArray")  # shell first, elements after (golden order)
    subs.add("NSInlinedValue", *b.boolean(False))
    o.add("UISubviews", *b.ref(subs))
    o.add("UIDeepDrawRect", *b.boolean(False))
    if el.get("multipleTouchEnabled") is not None:
        o.add("UIMultipleTouchEnabled", *b.boolean(el.get("multipleTouchEnabled") != "YES"))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    cm = _attr(el, "contentMode", where)
    if cm not in CONTENT_MODES:
        raise XibError(f"<tableViewCellContentView> contentMode={cm!r} not supported ({where})")
    o.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
    if el.get("clipsSubviews") is not None:
        o.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
    sv = el.find("subviews")
    if sv is None:
        raise XibError(f"<tableViewCellContentView> has no subviews ({where})")
    cons_el = el.find("constraints")
    referenced = set()
    for c in (cons_el.findall("constraint") if cons_el is not None else ()):
        for end in ("firstItem", "secondItem"):
            if c.get(end):
                referenced.add(c.get(end))
    kids = []
    tail = []  # per-kid constraint groups and deferred subtrees, in kid order
    events = []
    pairs = []
    for child in sv:
        cid = child.get("id")
        if child.tag == "label":
            kids.append(_cell_label(b, child, where, resources, roles.get(cid, ""))
                        if cid in roles else build_label(b, child, where)[0])
            if child.find("constraints") is not None:
                raise XibError(f"<label> with constraints not supported ({where})")
            pairs.extend(_uda_pairs(b, child, kids[-1], resources, named))
        elif child.tag == "switch":
            kid, kevents = build_switch(b, child, where, id_map, named)
            kids.append(kid)
            events.extend(kevents)
        elif child.tag == "slider":
            kids.append(build_slider(b, child, where, id_map, named))
        elif child.tag in ("imageView", "stackView", "textField", "button", "view"):
            kid, kgroups, kevents, kpairs, kdeferred = _build_subview(
                b, child, where, resources, named, id_map, referenced)
            kids.append(kid)
            tail.extend(kgroups)
            tail.extend(kdeferred)
            events.extend(kevents)
            pairs.extend(kpairs)
        else:
            raise XibError(f"unsupported subview <{child.tag}> in contentView ({where})")
        if cid:
            id_map[cid] = kids[-1]
    for k in kids:
        subs.add("UINibEncoderEmptyKey", *b.ref(k))
    if cons_el is not None:
        arr, cons = build_constraints_block(b, el, o, id_map, where)
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
        tail.insert(0, cons)
    if el.get("preservesSuperviewLayoutMargins") is not None:
        o.add("UIViewPreservesSuperviewMargins", *b.boolean(False))
        o.add("UIViewPreservesSpecificSuperviewMargins", *b.int8(15))
    if el.get("insetsLayoutMarginsFromSafeArea") is not None:
        o.add("UIViewInsetsLayoutMarginsFromSafeArea", *b.int8(0))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    return o, kids, tail, events, pairs
def build_cell(b, el, where, resources, named=None, id_map=None):
    """<tableViewCell> -> UIClassSwapper (Apple wraps custom-class cells)."""
    _check_shape(el, where)
    id_map = {} if id_map is None else id_map
    x, y, w, h = _frame(el)
    (_, _, _, _), (cx, cy) = _bounds_center(el)
    o = b.new("UITableViewCell" if el.get("customClass") is None else "UIClassSwapper")
    subs = b.new("NSMutableArray")  # shell; contentView + synthesized separator
    subs.add("NSInlinedValue", *b.boolean(False))
    o.add("UIBounds", *b.geom(0.0, 0.0, w, h))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UISubviews", *b.ref(subs))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIOpaque", *b.boolean(False))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    if el.get("clipsSubviews") is not None:
        o.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
    if el.get("preservesSuperviewLayoutMargins") is not None:
        o.add("UIViewPreservesSuperviewMargins", *b.boolean(False))
        o.add("UIViewPreservesSpecificSuperviewMargins", *b.int8(15))
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)

    cv_el = el.find("tableViewCellContentView[@key='contentView']")
    if cv_el is None:
        raise XibError(f"<tableViewCell> has no contentView ({where})")
    roles = {}
    if el.get("textLabel"):
        roles[el.get("textLabel")] = "text"
    if el.get("detailTextLabel"):
        roles[el.get("detailTextLabel")] = "detail"
    # Creation order = golden: contentView subtree, separator, then the
    # swapper's own strings (reuse identifier, class names).
    if el.get("id"):
        id_map[el.get("id")] = o
    cv, kids, tail, kevents, kpairs = build_content_view(b, cv_el, where, resources, roles, id_map, named)
    # Apple synthesizes the separator: 1pt full-width view at the cell bottom.
    sep = b.new("_UITableViewCellSeparatorView")
    sep.add("UIBounds", *b.geom(0.0, 0.0, w - 8.0, 1.0))
    sep.add("UICenter", *b.geom(8.0 + (w - 8.0) / 2, h - 0.5))
    sep.add("UIDeepDrawRect", *b.boolean(False))
    sep.add("UIOpaque", *b.boolean(False))
    sep.add("UIAutoresizeSubviews", *b.boolean(False))
    sep.add("UIViewSemanticContentAttribute", *b.int8(0))
    sep.add("UIViewLargeContentStoredProperties", N.NIL, None)
    subs.add("UINibEncoderEmptyKey", *b.ref(cv))
    subs.add("UINibEncoderEmptyKey", *b.ref(sep))

    # selectionStyle="none" cells (and all plain cells) carry a synthesized
    # system background (oracle: the insetGrouped Settings/Feed static cells).
    bgview = None
    plain_color = None
    if el.get("selectionStyle") == "none" or el.get("customClass") is None:
