             "viewLayoutGuide", "subviews", "constraints",
             "userDefinedRuntimeAttributes"},
    "switch": {"frame", "autoresizingMask", "onTintColor", "connections"},
    "slider": {"frame", "autoresizingMask", "thumbTintColor", "connections",
