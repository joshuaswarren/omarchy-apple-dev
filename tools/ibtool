class _Scene:
    """Per-nib state: builder, shared empty array, deferred runtime-attribute
    (element, target) pairs."""

    def __init__(self):
        self.b = Builder()
        self.pairs = []
        self.empty = None

    def empty_array(self):
        if self.empty is None:
            arr = self.b.new("NSArray")
            arr.add("NSInlinedValue", *self.b.boolean(False))
            self.empty = arr
        return self.empty

    def emit_pairs(self):
        """UINibKeyValuePairs array or None; boolean values pool into one
        NSNumber. The array object is created only when pairs exist (an unused
        empty array would shift every later index)."""
        if not self.pairs:
            return None
        b = self.b
        arr = b.new("NSArray")
        arr.add("NSInlinedValue", *b.boolean(False))
        boolnum = None
        for el, target in self.pairs:
            u = el.find("userDefinedRuntimeAttributes")
            for a in (u.findall("userDefinedRuntimeAttribute") if u is not None else ()):
                t, kp = a.get("type"), a.get("keyPath")
                p = b.new("UINibKeyValuePair")
                if t == "boolean":
                    if boolnum is None:
                        boolnum = b.new("NSNumber")
                        boolnum.add("NS.intval", *b.int8(1))
                    v = boolnum
                elif t == "string":
                    v = b.string(_attr(a, "value", f"runtime attribute {kp!r}"))
                else:
                    raise XibError(f"unsupported runtime attribute type {t!r} ({kp})")
                p.add("UIObject", *b.ref(target))
                p.add("UIValue", *b.ref(v))
                p.add("UIKeyPath", *b.ref(b.string(kp)))
                arr.add("UINibEncoderEmptyKey", *b.ref(p))
        return arr


def _bool_key(el, name):
    """Apple stores UI* flags inverted: attr YES -> stored false; else absent."""
    if el.get(name) == "YES":
        return False
    return None


def _image_ref(b, image_el, where):
    name = _attr(image_el, "image", where)
    obj = b.new("UIImageNibPlaceholder")
    catalog = image_el.get("catalog") == "system"
    if catalog:
        obj.add("UIImageWidth", *b.float32(0.0))
        obj.add("UIImageHeight", *b.float32(0.0))
    else:
        obj.add("UIImageWidth", *b.float32(1.0))
        obj.add("UIImageHeight", *b.float32(1.0))
    obj.add("UIResourceName", *b.ref(b.string(name)))
    if catalog:
        obj.add("UISystemSymbolResourceName", *b.ref(b.string(name)))
    else:
        obj.add("UISystemSymbolResourceName", N.NIL, None)
    scale = image_el.get("symbolScale")
    if scale is not None:
        if scale not in SYMBOL_SCALES:
            raise XibError(f"<imageReference> symbolScale={scale!r} unsupported ({where})")
        cfg = b.new("UIImageSymbolConfiguration")
        cfg.add("UISymbolScale", *b.int8(SYMBOL_SCALES[scale]))
        obj.add("UISymbolImageConfiguration", *b.ref(cfg))
    else:
        obj.add("UISymbolImageConfiguration", N.NIL, None)
    obj.add("UIResourceCatalogName", N.NIL, None)
    return obj


def _symbol_config(b, el, key, where):
    elc = el.find(key)
    if elc is None:
        # the child element may carry the key as an attribute instead of its
        # tag (<buttonConfiguration><preferredSymbolConfiguration key=
        # "preferredSymbolConfigurationForImage" .../>)
        for e in el:
            if isinstance(e.tag, str) and e.get("key") == key:
                elc = e
                break
    if elc is None:
        return None
    scale, weight = elc.get("scale"), elc.get("weight")
    if (scale is not None and scale not in SYMBOL_SCALES) or \
            (weight is not None and weight not in SYMBOL_WEIGHTS) or \
            set(elc.attrib) - {"key", "scale", "weight"}:
        raise XibError(f"<{key.split('.')[-1]}> unsupported ({where})")
    if scale is None and weight is None:
        raise XibError(f"<{key.split('.')[-1]}> empty ({where})")
    cfg = b.new("UIImageSymbolConfiguration")
    if scale is not None:
        cfg.add("UISymbolScale", *b.int8(SYMBOL_SCALES[scale]))
    if weight is not None:
        cfg.add("UISymbolWeight", *b.int8(SYMBOL_WEIGHTS[weight]))
    return cfg


def _flow_layout(sb, el, where):
    _check_shape(el, where)
    b = sb.b
    o = b.new("UICollectionViewFlowLayout")
    if el.get("automaticEstimatedItemSize") == "YES":
        sb.pairs.append(("__flow__", o))
    line = float(el.get("minimumLineSpacing", FLOW_LAYOUT_DEFAULT_SPACING))
    if line != FLOW_LAYOUT_DEFAULT_SPACING:
        o.add("UILineSpacing", *b.float32(line))
    if float(el.get("minimumInteritemSpacing", FLOW_LAYOUT_DEFAULT_SPACING)) != FLOW_LAYOUT_DEFAULT_SPACING:
        raise XibError(f"<collectionViewFlowLayout> minimumInteritemSpacing unsupported ({where})")
    item = el.find("size[@key='itemSize']")
    if item is None:
        raise XibError(f"<collectionViewFlowLayout> needs itemSize ({where})")
    o.add("UIItemSize", *b.geom(float(item.get("width")), float(item.get("height"))))
    head = el.find("size[@key='headerReferenceSize']")
    foot = el.find("size[@key='footerReferenceSize']")
    if foot is not None and (float(foot.get("width")), float(foot.get("height"))) != (0.0, 0.0):
        raise XibError(f"<collectionViewFlowLayout> footerReferenceSize unsupported ({where})")
    if head is not None and (float(head.get("width")), float(head.get("height"))) != (0.0, 0.0):
        o.add("UIHeaderReferenceSize",
              *b.geom(float(head.get("width")), float(head.get("height"))))
    if el.get("sectionInsetReference") is not None:
        if el.get("sectionInsetReference") != "safeArea":
            raise XibError(f"<collectionViewFlowLayout> sectionInsetReference="
                           f"{el.get('sectionInsetReference')!r} unsupported ({where})")
        o.add("UISectionInsetReference", *b.int8(1))
    ins = el.find("inset[@key='sectionInset']")
    if ins is not None:
        mx, my = float(ins.get("minX", "0.0")), float(ins.get("minY", "0.0"))
        Mx, My = float(ins.get("maxX", "0.0")), float(ins.get("maxY", "0.0"))
        if any((mx, my, Mx, My)):
            o.add("UISectionInset", *b.geom(my, mx, My, Mx))
    return o


def _estimated_item_size_value(b):
    v = b.new("NSValue")
    v.add("NS.special", *b.int8(2))
    v.add("NS.sizeval", *b.ref(b.string(ESTIMATED_ITEM_SIZE)))
    return v


def _view_common(b, el, o, where, resources, named, subs_slot):
    """Shared view keys after UISubviews: DeepDrawRect, inverted flags, mask,
    content mode, clips, tint, DoesNotTranslate."""
    o.add("UIDeepDrawRect", *b.boolean(False))
    if el.get("opaque") != "NO":
        o.add("UIOpaque", *b.boolean(False))
    hidden = _bool_key(el, "hidden")
    if hidden is not None:
        o.add("UIHidden", *b.boolean(hidden))
    mt = _bool_key(el, "multipleTouchEnabled")
    if mt is not None:
        o.add("UIMultipleTouchEnabled", *b.boolean(mt))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(_autoresizing_mask(el, where)))
    cm = el.get("contentMode")
    if cm is not None and cm != "scaleToFill":
        if cm not in CONTENT_MODES:
            raise XibError(f"<{el.tag}> contentMode={cm!r} not supported ({where})")
        o.add("UIContentMode", *b.int8(CONTENT_MODES[cm]))
    if el.get("clipsSubviews") is not None:
        o.add("UIClipsToBounds", *b.boolean(el.get("clipsSubviews") != "YES"))
    tint = el.find("color[@key='tintColor']")
    if tint is not None:
        o.add("UITintColor", *b.ref(build_color_el(b, tint, where, resources, named)))
    tr = el.get("translatesAutoresizingMaskIntoConstraints")
    if tr is not None:
        o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
              *b.boolean(tr != "NO"))


def _build_kids(sb, el, where, resources, named, id_map, state):
    """Subview closures of one element -> (kids, groups, events). Each kid's
    decode tuple (obj, cons group) is recorded in state in document order."""
    subs_el = el.find("subviews")
    kids, groups, events = [], [], []
    for child in (subs_el if subs_el is not None else ()):
        kid, kgroups, kevents = _scene_element(sb, child, where, resources, named,
                                               id_map, state)
        kids.append(kid)
        groups.extend(kgroups)
        events.extend(kevents)
        state.setdefault("kid_decode", []).append((kid, kgroups))
    return kids, groups, events


def _scene_button(sb, el, where, resources, named, id_map):
    """<button> with buttonConfiguration (Folder-cell golden)."""
    b = sb.b
    if el.get("buttonType") != "system":
        raise XibError(f"<button> buttonType={el.get('buttonType')!r} unsupported ({where})")
    cfg_el = el.find("buttonConfiguration[@key='configuration']")
    if cfg_el is None:
        raise XibError(f"<button> needs buttonConfiguration ({where})")
    state_el = el.find("state[@key='normal']")
    if state_el is None or set(state_el.attrib) != {"key", "title"}:
        raise XibError(f"<button> state shape unsupported ({where})")
    (bx, by, bw, bh), (cx, cy) = _bounds_center(el)
    o = b.new("UIButton")
    if el.get("id"):
        id_map[el.get("id")] = o
    o.add("UIBounds", *b.geom(bx, by, bw, bh))
    o.add("UICenter", *b.geom(cx, cy))
    o.add("UIDeepDrawRect", *b.boolean(False))
    o.add("UIAutoresizeSubviews", *b.boolean(False))
    o.add("UIAutoresizingMask", *b.int8(_autoresizing_mask(el, where)))
    tr = el.get("translatesAutoresizingMaskIntoConstraints")
    if tr is not None:
        o.add("UIViewDoesNotTranslateAutoresizingMaskIntoConstraints",
              *b.boolean(tr != "NO"))
    group = []
    if el.find("constraints") is not None:
        arr, cons = build_constraints_block(b, el, o, id_map, where)
        o.add("UIViewAutolayoutConstraints", *b.ref(arr))
        group.append(cons)
    o.add("UIViewSemanticContentAttribute", *b.int8(0))
    o.add("UIViewLargeContentStoredProperties", N.NIL, None)
    o.add("UIAdjustsImageWhenHighlighted", *b.boolean(False))
    o.add("UIAdjustsImageWhenDisabled", *b.boolean(False))
    o.add("UIButtonType", *b.int8(1))
    style = cfg_el.get("style", "plain")
    cfg = b.new("UIButtonConfiguration")
    cfg.add("UIButtonConfigurationButtonStyle", *b.int8(0))
    cfg.add("UIButtonConfigurationBackground",
            *b.ref(_background_configuration(b, style, where)))
    cfg.add("UIButtonConfigurationCornerStyle", *b.int8(0))
    cfg.add("UIButtonConfigurationButtonSize", *b.int8(0))
    cfg.add("UIButtonConfigurationMacIdiomStyle", *b.int8(0))
    cfg.add("UIButtonConfigurationBaseBackgroundColor", N.NIL, None)
    fg = cfg_el.find("color[@key='baseForegroundColor']")
    if fg is None or fg.get("systemColor") != "labelColor":
        raise XibError(f"<buttonConfiguration> baseForegroundColor unsupported ({where})")
    cfg.add("UIButtonConfigurationBaseForegroundColor",
            *b.ref(build_color(b, "labelColor", where)))
    img = cfg_el.find("imageReference[@key='image']")
    if img is None:
        raise XibError(f"<buttonConfiguration> needs an imageReference ({where})")
    cfg.add("UIButtonConfigurationImage", *b.ref(_image_ref(b, img, where)))
    psym = _symbol_config(b, cfg_el, "preferredSymbolConfigurationForImage", where)
    if psym is None:
        cfg.add("UIButtonConfigurationPreferredSymbolConfigurationForImage", N.NIL, None)
    else:
        cfg.add("UIButtonConfigurationPreferredSymbolConfigurationForImage", *b.ref(psym))
    cfg.add("UIButtonConfigurationSymbolContentTransition", N.NIL, None)
    cfg.add("UIButtonConfigurationShowsActivityIndicator", *b.boolean(True))
    t = b.new("NSAttributedString")
    t.add("NSString", *b.ref(b.string("")))
    cfg.add("UIButtonConfigurationTitle", *b.ref(t))
    u = b.new("NSAttributedString")
    u.add("NSString", *b.ref(b.string("")))
    cfg.add("UIButtonConfigurationSubtitle", *b.ref(u))
    cfg.add("UIButtonConfigurationImagePlacement", *b.int8(2))
    cfg.add("UIButtonConfigurationImagePadding", *b.float32(0.0))
    cfg.add("UIButtonConfigurationTitlePadding", *b.float32(1.0))
    cfg.add("UIButtonConfigurationTitleAlignment", *b.int8(0))
    o.add("UIButtonConfiguration", *b.ref(cfg))
    events = []
    conns = el.find("connections")
    for ac in (conns.findall("action") if conns is not None else ()):
        sel = _attr(ac, "selector", where)
        et = ac.get("eventType", "touchUpInside")
        if et not in EVENT_MASKS:
            raise XibError(f"eventType {et!r} unsupported ({where})")
        events.append((sel, EVENT_MASKS[et], o, _attr(ac, "destination", where)))
    return o, group, events


